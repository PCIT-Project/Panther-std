@setModuleName("std.math");

def std #private = @import("std");


def PI   = 3.1415926535897932384626433832795029;
def TAU  = 6.2831853071795864769252867665590058;
def E    = 2.7182818284590452353602874713526625;




func isPowOf2 = (num: $Integral)  -> Bool {
	return std.popCount(num) == 1;
}


func ceilToPowOf2Multiple = (num: $Integral, multiple: Integral)  -> Integral {
	@comptimeAssert(std.types.isIntegral<{Integral}>(), "Type must be integral");
	std.debug.assert(multiple != 0, "Multiple cannot be 0");
	std.debug.assert(isPowOf2(multiple), "Multiple must be power of 2");

	return (num + (multiple - 1)) & ~(multiple - 1);
}

func ceilToMultiple = (num: $Integral, multiple: Integral)  -> Integral {
	@comptimeAssert(std.types.isIntegral<{Integral}>(), "Type must be integral");
	std.debug.assert(multiple != 0, "Multiple cannot be 0");

	if(isPowOf2(multiple)){ return ceilToPowOf2Multiple(num, multiple);	}
	return ((num + multiple - 1) / multiple) * multiple;
}




func floorToPowOf2Multiple = (num: $Integral, multiple: Integral)  -> Integral {
	@comptimeAssert(std.types.isIntegral<{Integral}>(), "Type must be integral");
	std.debug.assert(multiple != 0, "Multiple cannot be 0");
	std.debug.assert(isPowOf2(multiple), "Multiple must be power of 2");


	return ceilToPowOf2Multiple(num, multiple) - multiple;
}

func floorToMultiple = (num: $Integral, multiple: Integral)  -> Integral {
	@comptimeAssert(std.types.isIntegral<{Integral}>(), "Type must be integral");

	if(isPowOf2(multiple)){ return floorToPowOf2Multiple(num, multiple); }

	when(std.types.isUnsignedIntegral<{Integral}>()){
		std.debug.assert(multiple != 0, "Multiple cannot be 0");

		return num / multiple * multiple;

	}else{
		std.debug.assert(multiple > 0, "Multiple must be positive");

		return num / multiple * multiple - (multiple * (num < 0) as Integral);
	}
}


func abs = (num: $Num)  -> Num {
	@comptimeAssert(std.types.isUnsignedIntegral<{Num}>() == false, "Type cannot be unsigned integral");
	@comptimeAssert(std.types.isSignedIntegral<{Num}>() || std.types.isFloatingPoint<{Num}>(), "Invalid type");

	if(num < 0 as Num){
		return num * -1;
	}
	return copy num;
}

func min = (lhs: $Num, rhs: Num)  -> Num {
	if(lhs < rhs){
		return copy lhs;
	}else{
		return copy rhs;
	}
}

func max = (lhs: $Num, rhs: Num)  -> Num {
	if(lhs > rhs){
		return copy lhs;
	}else{
		return copy rhs;
	}
}



func infinity = <{T: Type}> () -> T {
	@comptimeAssert(std.types.isFloatingPoint<{T}>(), "`std.math.infinity` only accepts floating-point types");
	when switch(std.types.numBits<{T, false}>()){
		case(16){  return makeF16FromInt(0x7C00);                                  }
		case(32){  return makeF32FromInt(0x7F800000);                              }
		case(64){  return makeF64FromInt(0x7FF0000000000000);                      }
		case(80){  return makeF80FromInt(0x7FFF, 0x800000000000);                  }
		case(128){ return makeF128FromInt(0x7FFF000000000000, 0x0000000000000000); }
		else{ unreachable; }
	}
}

func defaultNaN = <{T: Type}> () -> T {
	@comptimeAssert(std.types.isFloatingPoint<{T}>(), "`std.math.defaultNaN` only accepts floating-point types");
	return quietNaN<{T}>();
}

func signalingNaN = <{T: Type}> () -> T {
	@comptimeAssert(std.types.isFloatingPoint<{T}>(), "`std.math.signalingNaN` only accepts floating-point types");
	when switch(std.types.numBits<{T, false}>()){
		case(16){  return makeF16FromInt(0x7D00);                                  }
		case(32){  return makeF32FromInt(0x7FA00000);                              }
		case(64){  return makeF64FromInt(0x7FF4000000000000);                      }
		case(80){  return makeF80FromInt(0x7FFF, 0xA00000000000);                  }
		case(128){ return makeF128FromInt(0x7FFF400000000000, 0x0000000000000000); }
		else{ unreachable; }
	}
}

func quietNaN = <{T: Type}> () -> T {
	@comptimeAssert(std.types.isFloatingPoint<{T}>(), "`std.math.quietNaN` only accepts floating-point types");
	when switch(std.types.numBits<{T, false}>()){
		case(16){  return makeF16FromInt(0x7E00);                                  }
		case(32){  return makeF32FromInt(0x7FC00000);                              }
		case(64){  return makeF64FromInt(0x7FF8000000000000);                      }
		case(80){  return makeF80FromInt(0x7FFF, 0xC00000000000);                  }
		case(128){ return makeF128FromInt(0x7FFF800000000000, 0x0000000000000000); }
		else{ unreachable; }
	}
}




func makeF16FromInt = (num: UI16) #ct -> F16 {
	return unsafe{std.bitCast<{F16}>(num)};
}

func makeF32FromInt = (num: UI32) #ct -> F32 {
	return unsafe{std.bitCast<{F32}>(num)};
}

func makeF64FromInt = (num: UI64) #ct -> F64 {
	return unsafe{std.bitCast<{F64}>(num)};
}

func makeF80FromInt = (upper: UI16, lower: UI64) #ct -> F80 {
	return unsafe{std.bitCast<{F80}>(upper as UI80 << 64 | lower as UI80)};
}

func makeF128FromInt = (upper: UI64, lower: UI64) #ct -> F128 {
	return unsafe{std.bitCast<{F128}>(upper as UI128 << 64 | lower as UI128)};
}