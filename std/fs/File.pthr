@setModuleName("std.fs");

def std #private = @import("std");




type File = struct {
	when switch(@config.platform){
		case(std.Platform.FREESTANDING){
			type Handle = delete("std.fs.File.Handle is not supported in frestanding platform target");
			type NativeError = delete("std.fs.File.NativeError is not supported in frestanding platform target");
			
		}case(std.Platform.LINUX){
			type Handle = alias std.platform.linux.FileDescriptor;
			type NativeError = alias std.platform.linux.Errno;
			
		}case(std.Platform.PANTHER_VM){
			type Handle = alias std.platform.pantherVM.FileHandle;
			type NativeError = struct{}
			
		}case(std.Platform.WINDOWS){
			type Handle = alias std.platform.windows.Handle;
			type NativeError = alias std.platform.windows.NTStatus;
		}
	}


	func new = () -> (output: This) {
		output.handle = null;
		return...;
	}

	func new = (handle: Handle in) -> (output: This) {
		output.handle = forward handle;
		return...;
	}


	func delete = (this mut) #rt -> Void {
		if(this.isOpen()){ this.close_without_resetting_handle(); }
	}


	func createStdout = () #rt -> (output: File) {
		when switch(@config.platform){
			case(std.Platform.FREESTANDING){
				unreachable("`std.fs.File` is not supported in freestanding platform target");
			}

			case(std.Platform.LINUX){
				output = new File(std.platform.linux.STDOUT);
			}

			case(std.Platform.PANTHER_VM){
				output = new File(std.platform.pantherVM.STDOUT);
			}

			case(std.Platform.WINDOWS){
				output = new File(std.platform.windows.getStdoutHandle());
			}
		}
		return...;
	}



	///////////////////////////////////
	// open

	type OpenError = enum {
		BUSY,
		DENIED,
		INVALID_PATH,
		PATH_NOT_FILE,
		PATH_NOT_FOUND,
		OTHER,
	}


	func open = (path: std.fs.PathRef) #rt -> This <err: OpenError, native_err: NativeError> {
		std.debug.assert(path.isAbsolute(), "`std.fs.File.open` - file path must be absolute");

		when switch(@config.platform){
			case(std.Platform.FREESTANDING){
				unreachable("`std.fs.File.open` is not supported in frestanding platform target");
			}


			case(std.Platform.LINUX){
				def linux = std.platform.linux;

				var file_descriptor: Handle = try linux.open(
					path.str,
					linux.O.RDWR | linux.O.CLOEXEC,
					(linux.Permissions.IRUSR | linux.Permissions.IWUSR) as linux.Mode
				) else<errno: linux.Errno> {
					native_err = copy errno;

					switch(errno){
						case(linux.Errno.ACCES)       { err = OpenError.DENIED;            }
						case(linux.Errno.BADF)        {
							unreachable("`std.fs.File` - handle is invalid to std.platform.linux.open");
						}
						case(linux.Errno.BUSY)        { err = OpenError.BUSY;              }
						case(linux.Errno.FAULT)       { err = OpenError.DENIED;            }
						case(linux.Errno.INTR){
							// TODO(FUTURE): when calling from scheduler thread, 
							err = OpenError.OTHER;
						}
						case(linux.Errno.INVAL)       { err = OpenError.INVALID_PATH;      }
						case(linux.Errno.ISDIR)       { err = OpenError.PATH_NOT_FILE; }
						case(linux.Errno.NAMETOOLONG) { err = OpenError.INVALID_PATH;      }
						case(linux.Errno.NOENT)       { err = OpenError.PATH_NOT_FOUND;    }
						case(linux.Errno.NOTDIR)      { err = OpenError.PATH_NOT_FOUND;    }
						case(linux.Errno.PERM)        { err = OpenError.DENIED;            }
						case(linux.Errno.ROFS)        { err = OpenError.DENIED;            }
						case(linux.Errno.TXTBSY)      { err = OpenError.BUSY;              }
						else                          { err = OpenError.OTHER;             }
					}

					error...;
				};

				return new File(move file_descriptor);
			}

			case(std.Platform.PANTHER_VM){
				unreachable("`std.fs.File.open` is not supported in Panther platform target");
			}

			case(std.Platform.WINDOWS){
				when(@config.mode == std.Mode.DEBUG){
					std.debug.assert(
						path.isUNC(),
						"`std.fs.File.open` - on windows, path must be UNC (Universal Naming Convention), "
							++ "such as having prefix `\\??\\`"
					);
					
					for(path.str) [_; character: CWChar] {
						std.debug.assert(
							character != '/' as CWChar,
							"`std.fs.File.open` - path must have platform preferred separators"
						);
					}
				}


				def windows = std.platform.windows;

				var file_handle: std.platform.windows.Handle = try std.platform.windows.ntCreateFile(
					path.str,
					null,
					windows.FileAccess.GENERIC_WRITE,
					windows.FileAttribute.NORMAL,
					windows.FileShareAccess.READ | windows.FileShareAccess.WRITE | windows.FileShareAccess.DELETE,
					windows.FileCreateDisposition.OVERWRITE,
					windows.FileCreateOptions.RANDOM_ACCESS
						| windows.FileCreateOptions.SYNCHRONOUS_IO_NONALERT
						| windows.FileCreateOptions.NON_DIRECTORY_FILE
				) else<nt_status: windows.NTStatus> {
					native_err = copy nt_status;

					switch(nt_status){
						case(windows.NTStatus.ACCESS_DENIED)    { err = OpenError.DENIED;         }
						case(windows.NTStatus.BAD_NETWORK_PATH) { err = OpenError.PATH_NOT_FOUND; }
						case(windows.NTStatus.BAD_NETWORK_NAME) { err = OpenError.PATH_NOT_FOUND; }

						case(windows.NTStatus.CANCELLED){
							// TODO(FUTURE): when calling from scheduler thread, 
							err = OpenError.OTHER;
						}

						case(windows.NTStatus.DELETE_PENDING)      { err = OpenError.BUSY;  }
						case(windows.NTStatus.FILE_IS_A_DIRECTORY) { err = OpenError.PATH_NOT_FILE; }

						case(windows.NTStatus.INVALID_HANDLE){
							unreachable("std.fs.File - invalid handle to std.platform.windows.ntCreateFile");
						}
						case(windows.NTStatus.INVALID_PARAMETER){
							unreachable("std.fs.File - Invalid parameter to std.platform.windows.ntCreateFile");
						}

						case(windows.NTStatus.OBJECT_NAME_INVALID)    { err = OpenError.INVALID_PATH;   }
						case(windows.NTStatus.OBJECT_NAME_NOT_FOUND)  { err = OpenError.PATH_NOT_FOUND; }
						case(windows.NTStatus.OBJECT_PATH_NOT_FOUND)  { err = OpenError.PATH_NOT_FOUND; }
						case(windows.NTStatus.OBJECT_PATH_SYNTAX_BAD) { err = OpenError.INVALID_PATH;   }
						case(windows.NTStatus.PIPE_BUSY)              { err = OpenError.BUSY;           }
						case(windows.NTStatus.SHARING_VIOLATION)      { err = OpenError.BUSY;           }
						case(windows.NTStatus.USER_MAPPED_FILE)       { err = OpenError.DENIED;         }
						case(windows.NTStatus.VIRUS_INFECTED)         { err = OpenError.DENIED;         }
						case(windows.NTStatus.VIRUS_DELETED)          { err = OpenError.DENIED;         }
						else                                          { err = OpenError.OTHER;          }
					}

					error...;
				};

				return new File(move file_handle);
			}
		}
	}


	///////////////////////////////////
	// createOrOpen

	func createOrOpen = (path: std.fs.PathRef, may_create: Bool) #rt -> This <err: OpenError, native_err: NativeError> {
		std.debug.assert(path.isAbsolute(), "`std.fs.File.open` - file path must be absolute");

		when switch(@config.platform){
			case(std.Platform.FREESTANDING){
				unreachable("`std.fs.File.open` is not supported in frestanding platform target");
			}


			case(std.Platform.LINUX){
				def linux = std.platform.linux;

				var file_descriptor: Handle = try linux.open(
					path.str,
					linux.O.RDWR | linux.O.CREAT | linux.O.CLOEXEC,
					(linux.Permissions.IRUSR | linux.Permissions.IWUSR) as linux.Mode
				) else<errno: linux.Errno> {
					native_err = copy errno;

					switch(errno){
						case(linux.Errno.ACCES)       { err = OpenError.DENIED;            }
						case(linux.Errno.BADF)        {
							unreachable("`std.fs.File` - handle is invalid to std.platform.linux.open");
						}
						case(linux.Errno.BUSY)        { err = OpenError.BUSY;              }
						case(linux.Errno.FAULT)       { err = OpenError.DENIED;            }
						case(linux.Errno.INTR){
							// TODO(FUTURE): when calling from scheduler thread, 
							err = OpenError.OTHER;
						}
						case(linux.Errno.INVAL)       { err = OpenError.INVALID_PATH;      }
						case(linux.Errno.ISDIR)       { err = OpenError.PATH_NOT_FILE;     }
						case(linux.Errno.NAMETOOLONG) { err = OpenError.INVALID_PATH;      }
						case(linux.Errno.NOENT)       { err = OpenError.PATH_NOT_FOUND;    }
						case(linux.Errno.NOTDIR)      { err = OpenError.PATH_NOT_FOUND;    }
						case(linux.Errno.PERM)        { err = OpenError.DENIED;            }
						case(linux.Errno.ROFS)        { err = OpenError.DENIED;            }
						case(linux.Errno.TXTBSY)      { err = OpenError.BUSY;              }
						else                          { err = OpenError.OTHER;             }
					}

					error...;
				};

				return new File(move file_descriptor);
			}

			case(std.Platform.PANTHER_VM){
				unreachable("`std.fs.File.open` is not supported in Panther platform target");
			}

			case(std.Platform.WINDOWS){
				when(@config.mode == std.Mode.DEBUG){
					std.debug.assert(
						path.isUNC(),
						"`std.fs.File.open` - on windows, path must be UNC (Universal Naming Convention), "
							++ "such as having prefix `\\??\\`"
					);
					
					for(path.str) [_; character: CWChar] {
						std.debug.assert(
							character != '/' as CWChar,
							"`std.fs.File.open` - path must have platform preferred separators"
						);
					}
				}


				def windows = std.platform.windows;

				var file_handle: std.platform.windows.Handle = try std.platform.windows.ntCreateFile(
					path.str,
					null,
					windows.FileAccess.GENERIC_WRITE,
					windows.FileAttribute.NORMAL,
					windows.FileShareAccess.READ | windows.FileShareAccess.WRITE | windows.FileShareAccess.DELETE,
					windows.FileCreateDisposition.OVERWRITE,
					windows.FileCreateOptions.RANDOM_ACCESS
						| windows.FileCreateOptions.SYNCHRONOUS_IO_NONALERT
						| windows.FileCreateOptions.NON_DIRECTORY_FILE
				) else<nt_status: windows.NTStatus> {
					native_err = copy nt_status;

					switch(nt_status){
						case(windows.NTStatus.ACCESS_DENIED)    { err = OpenError.DENIED;         }
						case(windows.NTStatus.BAD_NETWORK_PATH) { err = OpenError.PATH_NOT_FOUND; }
						case(windows.NTStatus.BAD_NETWORK_NAME) { err = OpenError.PATH_NOT_FOUND; }

						case(windows.NTStatus.CANCELLED){
							// TODO(FUTURE): when calling from scheduler thread, 
							err = OpenError.OTHER;
						}

						case(windows.NTStatus.DELETE_PENDING)      { err = OpenError.BUSY;  }
						case(windows.NTStatus.FILE_IS_A_DIRECTORY) { err = OpenError.PATH_NOT_FILE; }

						case(windows.NTStatus.INVALID_HANDLE){
							unreachable("std.fs.File - invalid handle to std.platform.windows.ntCreateFile");
						}
						case(windows.NTStatus.INVALID_PARAMETER){
							unreachable("std.fs.File - Invalid parameter to std.platform.windows.ntCreateFile");
						}

						case(windows.NTStatus.OBJECT_NAME_INVALID)    { err = OpenError.INVALID_PATH;   }
						case(windows.NTStatus.OBJECT_NAME_NOT_FOUND)  { err = OpenError.PATH_NOT_FOUND; }
						case(windows.NTStatus.OBJECT_PATH_NOT_FOUND)  { err = OpenError.PATH_NOT_FOUND; }
						case(windows.NTStatus.OBJECT_PATH_SYNTAX_BAD) { err = OpenError.INVALID_PATH;   }
						case(windows.NTStatus.PIPE_BUSY)              { err = OpenError.BUSY;           }
						case(windows.NTStatus.SHARING_VIOLATION)      { err = OpenError.BUSY;           }
						case(windows.NTStatus.USER_MAPPED_FILE)       { err = OpenError.DENIED;         }
						case(windows.NTStatus.VIRUS_INFECTED)         { err = OpenError.DENIED;         }
						case(windows.NTStatus.VIRUS_DELETED)          { err = OpenError.DENIED;         }
						else                                          { err = OpenError.OTHER;          }
					}

					error...;
				};

				return new File(move file_handle);
			}
		}
	}



	///////////////////////////////////
	// create


	type CreateError = enum {
		DENIED,
		INVALID_PATH,
		PATH_ALREADY_EXISTS,
		OTHER,
	}


	func create = (path: std.fs.PathRef) #rt -> This <err: CreateError, native_err: NativeError> {
		std.debug.assert(path.isAbsolute(), "`std.fs.File.create` - file path must be absolute");

		when switch(@config.platform){
			case(std.Platform.FREESTANDING){
				unreachable("`std.fs.File.create` is not supported in frestanding platform target");
			}


			case(std.Platform.LINUX){
				def linux = std.platform.linux;

				var file_descriptor: Handle = try linux.open(
					path.str,
					linux.O.RDWR | linux.O.CREAT | linux.O.EXCL | linux.O.CLOEXEC,
					(linux.Permissions.IRUSR | linux.Permissions.IWUSR) as linux.Mode
				) else<errno: linux.Errno> {
					native_err = copy errno;

					switch(errno){
						case(linux.Errno.ACCES)       { err = CreateError.DENIED;              }
						case(linux.Errno.BADF)        {
							unreachable("std.fs.File - invalid handle to std.platform.linux.open");
						}
						case(linux.Errno.EXIST)       { err = CreateError.PATH_ALREADY_EXISTS; }
						case(linux.Errno.FAULT)       { err = CreateError.INVALID_PATH;        }
						case(linux.Errno.INTR){
							// TODO(FUTURE): when calling from scheduler thread, 
							err = CreateError.OTHER;
						}
						case(linux.Errno.INVAL)       { err = CreateError.INVALID_PATH;        }
						case(linux.Errno.NAMETOOLONG) { err = CreateError.INVALID_PATH;        }
						case(linux.Errno.NOENT)       { err = CreateError.INVALID_PATH;        }
						case(linux.Errno.NOTDIR)      { err = CreateError.INVALID_PATH;        }
						case(linux.Errno.PERM)        { err = CreateError.DENIED;              }
						case(linux.Errno.ROFS)        { err = CreateError.DENIED;              }
						else                          { err = CreateError.OTHER;               }
					}

					error...;
				};

				return new File(move file_descriptor);
			}

			case(std.Platform.PANTHER_VM){
				unreachable("`std.fs.File.create` is not supported in Panther platform target");
			}

			case(std.Platform.WINDOWS){
				when(@config.mode == std.Mode.DEBUG){
					std.debug.assert(
						path.isUNC(),
						"`std.fs.File.create` - on windows, path must be UNC (Universal Naming Convention), "
							++ "such as having prefix `\\??\\`"
					);
					
					for(path.str) [_; character: CWChar] {
						std.debug.assert(
							character != '/' as CWChar,
							"`std.fs.File.create` - path must have platform preferred separators"
						);
					}
				}

				def windows = std.platform.windows;

				var file_handle: std.platform.windows.Handle = try std.platform.windows.ntCreateFile(
					path.str,
					null,
					windows.FileAccess.GENERIC_WRITE,
					windows.FileAttribute.NORMAL,
					windows.FileShareAccess.READ | windows.FileShareAccess.WRITE | windows.FileShareAccess.DELETE,
					windows.FileCreateDisposition.CREATE,
					windows.FileCreateOptions.RANDOM_ACCESS
						| windows.FileCreateOptions.SYNCHRONOUS_IO_NONALERT
						| windows.FileCreateOptions.NON_DIRECTORY_FILE
				) else<nt_status: windows.NTStatus> {
					native_err = copy nt_status;

					switch(nt_status){
						case(windows.NTStatus.ACCESS_DENIED)    { err = CreateError.DENIED;       }
						case(windows.NTStatus.BAD_NETWORK_PATH) { err = CreateError.INVALID_PATH; }
						case(windows.NTStatus.BAD_NETWORK_NAME) { err = CreateError.INVALID_PATH; }

						case(windows.NTStatus.CANCELLED){
							// TODO(FUTURE): when calling from scheduler thread, 
							err = CreateError.OTHER;
						}

						case(windows.NTStatus.FILE_IS_A_DIRECTORY) { err = CreateError.PATH_ALREADY_EXISTS; }

						case(windows.NTStatus.INVALID_HANDLE){
							unreachable("std.fs.File - invalid handle to std.platform.windows.ntCreateFile");
						}
						case(windows.NTStatus.INVALID_PARAMETER){
							unreachable("std.fs.File - invalid parameter to std.platform.windows.ntCreateFile");
						}

						case(windows.NTStatus.OBJECT_NAME_COLLISION)  { err = CreateError.PATH_ALREADY_EXISTS; }
						case(windows.NTStatus.OBJECT_NAME_INVALID)    { err = CreateError.INVALID_PATH;        }
						case(windows.NTStatus.OBJECT_NAME_NOT_FOUND)  { err = CreateError.INVALID_PATH;        }
						case(windows.NTStatus.OBJECT_PATH_SYNTAX_BAD) { err = CreateError.INVALID_PATH;        }
						case(windows.NTStatus.USER_MAPPED_FILE)       { err = CreateError.DENIED;              }
						case(windows.NTStatus.VIRUS_INFECTED)         { err = CreateError.DENIED;              }
						case(windows.NTStatus.VIRUS_DELETED)          { err = CreateError.DENIED;              }
						else                                          { err = CreateError.OTHER;               }
					}

					error...;
				};

				return new File(move file_handle);
			}
		}
	}



	///////////////////////////////////
	// methods

	func write = (this mut, str: [Char:*]) #rt -> Void {
		std.debug.assert(this.isOpen(), "std.fs.File cannot write as it is closed");

		// TODO(FUTURE): error handling
		when switch(@config.platform){
			case(std.Platform.FREESTANDING){
				unreachable("`std.fs.File` is not supported in freestanding platform target");
			}

			case(std.Platform.LINUX){
				_ = std.platform.linux.write(this.handle.?, str);
			}

			case(std.Platform.PANTHER_VM){
				try std.platform.pantherVM.fileWrite(this.handle.?, str)
					else<err: std.platform.pantherVM.FileWriteError> {};
			}

			case(std.Platform.WINDOWS){
				try std.platform.windows.ntWriteFile(this.handle.?, str)
					else<nt_status: std.platform.windows.NTStatus>
				{
					switch(nt_status){
						case(std.platform.windows.NTStatus.PENDING){
							unreachable("std.fs.File failed to write - NTStatus.PENDING");

						}case(std.platform.windows.NTStatus.CANCELLED){
							unreachable("std.fs.File failed to write - NTStatus.CANCELLED");
							
						}else{
							unreachable("std.fs.File failed to write - Unexpected Error");
						}
					}
				};
			}
		}
	}




	func close = (this mut) #rt -> Void {
		this.close_without_resetting_handle();
		this.handle = null;
	}


	func isOpen = (this) -> Bool { return this.handle != null; }

	func internalHandle = (this) -> Handle {
		std.debug.assert(this.isOpen(), "std.fs.File isn't open");
		return copy this.handle.?;
	}




	impl std.IWriter {
		write = (this mut, str: [Char:*]) #rtDiff -> Void {
			when(@isComptime()){
				unreachable("`std.fs.File` cannot write at comptime");
			}else{
				this.write(str);
			}
		},

		flush = (this mut) -> Void {},
	}


	///////////////////////////////////
	// private

	func close_without_resetting_handle = (this mut) #rt #private -> Void {
		std.debug.assert(this.isOpen(), "std.fs.File was already closed");

		when switch(@config.platform){
			case(std.Platform.FREESTANDING){
				unreachable("`std.fs.File` is not supported in frestanding platform target");
			}

			case(std.Platform.LINUX){
				try std.platform.linux.close(this.handle.?) else <errno: std.platform.linux.Errno> {
					switch(errno){
						case(std.platform.linux.Errno.BADF){
							unreachable("std.fs.File failed to close - handle is invalid to std.platform.linux.close");
						}else{
							unreachable("std.fs.File failed to close - Unexpected Error");
						}
						
					}
				};
			}

			case(std.Platform.PANTHER_VM){
				unreachable("`std.fs.File.close` is not supported in Panther platform target");
			}

			case(std.Platform.WINDOWS){
				try std.platform.windows.ntClose(this.handle.?) else<nt_status: std.platform.windows.NTStatus> {
					switch(nt_status){
						case(std.platform.windows.NTStatus.INVALID_HANDLE){
							unreachable("std.fs.File failed to close - NTStatus.INVALID_HANDLE");

						}case(std.platform.windows.NTStatus.HANDLE_NOT_CLOSABLE){
							unreachable("std.fs.File failed to close - NTStatus.HANDLE_NOT_CLOSABLE");

						}else{
							unreachable("std.fs.File failed to close - Unexpected Error");
						}
					}
				};
			}
		}
	}


	var handle: Handle? #private;
}


