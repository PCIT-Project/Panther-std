@setModuleName("std");

def std = @import("std");



interface IWriter = #pub #polymorphic {
	func write = (this mut, bytes: [Char:*]) -> Void;
	func flush = (this mut) -> Void;
}



type PmWriter = alias #pub Writer<{}>;

type Writer = struct <{TargetWriter: Type = impl(*mut:std.IWriter)}> #pub 
	#comptimeAssert(
		@getTypeID<{TargetWriter}>() != @getTypeID<{impl(*:std.IWriter)}>(),
		"Mutable access to the writer interface is required"
	)
{
	when(@getTypeID<{TargetWriter}>() == @getTypeID<{impl(*mut:std.IWriter)}>()){
		func new = (writer_impl: impl(*mut:std.IWriter)) -> (output: This) {
			output.writer_impl = copy writer_impl;
			return...;
		}

		func new = (writer_impl: $$ mut) -> (output: This) {
			output.writer_impl = writer_impl as impl(*mut:std.IWriter);
			return...;
		}
		
	}else{
		func new = (writer_impl: TargetWriter mut) -> (output: This) {
			output.writer_impl = &(writer_impl as impl(TargetWriter:std.IWriter));
			return...;
		}

		func new = (writer_impl: impl(TargetWriter:std.IWriter) mut) -> (output: This) {
			output.writer_impl = &writer_impl;
			return...;
		}
	}



	func write = (this mut, str: [Char:*]) -> Void {
		this.writer_impl.write(str);
	}

	func write = (this mut, fmt_str: std.fmt.FmtString, args: $$...) -> Void {
		fmt_str.write(this, args...);
	}


	func flush = (this mut) -> Void {
		this.writer_impl.flush();
	}


	///////////////////////////////////
	// private

	when(@getTypeID<{TargetWriter}>() == @getTypeID<{impl(*mut:std.IWriter)}>()){
		var writer_impl: TargetWriter #priv;
	}else{
		var writer_impl: impl(TargetWriter:std.IWriter)*mut #priv;
	}
}