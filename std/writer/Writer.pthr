@setModuleName("std");

def std = @import("std");



type IWriter = interface #pub {
	func write = (this mut, bytes: [Char:*]) -> Void;
	func flush = (this mut) -> Void;
}



type PmWriter = alias #pub Writer<{impl(*mut:std.IWriter)}>;

type Writer = struct <{TargetWriter: Type}> #pub {
	func new = (writer_impl: impl*mut(TargetWriter:std.IWriter)) -> (output: This) {
		output.writer_impl = copy writer_impl;
		return...;
	}


	func write = (this mut, str: [Char:*]) -> Void {
		this.writer_impl.write(str);
	}

	func write = (this mut, char: Char) -> Void {
		this.writer_impl.write(new [Char:*](&char, 1));
	}

	func write = (this mut, fmt_str: std.fmt.FmtString, args: $$...) -> Void {
		fmt_str.write(this, args...);
	}


	func flush = (this mut) -> Void {
		this.writer_impl.flush();
	}


	///////////////////////////////////
	// private

	var writer_impl: impl*mut(TargetWriter:std.IWriter);
}