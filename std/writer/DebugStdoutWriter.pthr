@setModuleName("std");

def std = @import("std");


type DebugStdoutWriter = struct #pub {
	func write = (this mut, str: [Char:*]) -> Void {
		std.debug.print(str);
	}

	func flush = (this mut) -> Void {
		// not buffered, do nothing
	}

	impl std.IWriter {
		write = write,
		flush = flush,
	}
}