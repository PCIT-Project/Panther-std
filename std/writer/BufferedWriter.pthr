@setModuleName("std");

def std #priv = @import("std");


type PmBufferedWriter = alias BufferedWriter<{impl(*mut:std.IWriter)}>;

type BufferedWriter = struct <{TargetWriter: Type}> {
	func new = (writer_backend: impl*mut(TargetWriter:std.IWriter), buffer: [Char:*mut]) -> (output: This) {
		std.debug.assert(buffer.size() != 0, "std.BufferedWriter cannot have an empty buffer");

		output.writer_backend = copy writer_backend;
		output.buffer = copy buffer;
		return...;
	}


	func write = (this mut, str: [Char:*]) -> Void {
		if(this.buffer_index + str.size() <= this.buffer.size()){
			std.mem.copyBuffer(new [Char:*mut](this.buffer[this.buffer_index], str.size()), str);
			this.buffer_index += str.size();

		}else{
			this.flush();
			this.writer_backend.write(str);
		}
	}


	func flush = (this mut) -> Void {
		this.writer_backend.write(new [Char:*](copy this.buffer.data().?, copy this.buffer_index));
		this.buffer_index = 0;
	}


	impl std.IWriter {
		write = write,
		flush = flush,
	}


	///////////////////////////////////
	// private

	var writer_backend: impl*mut(TargetWriter:std.IWriter) #priv;

	var buffer: [Char:*mut] #priv;
	var buffer_index: USize #priv = 0;
}