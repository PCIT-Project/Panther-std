@setModuleName("std");

def std = @import("std");


type ComptimeStdoutWriter = struct #pub {
	func write = (this mut, str: [Char:*]) #ct -> Void {
		@comptimePrint(str);
	}

	func flush = (this mut) -> Void {
		// not buffered, do nothing
	}

	impl std.IWriter {
		write = (this mut, str: [Char:*]) #rtDiff -> Void {
			when(@isComptime()){
				this.write(str);

			}else{
				unreachable("std.ComptimeStdoutWriter cannot write at runtime");
			}
		},

		flush = flush,
	}
}