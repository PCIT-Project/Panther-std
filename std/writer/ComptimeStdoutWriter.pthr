@setModuleName("std");

def std = @import("std");


type ComptimeStdoutWriter = struct #pub {
	func write = (this mut, buffer: [Byte:*]) #ct -> Void {
		const str: [Char:*] = {->expr:[Char:*]
			unsafe{
				return->expr new [Char:*](std.bitCast<{Char*}>(buffer.data()), buffer.size());
			}
		};

		this.write(str);
	}

	func write = (this mut, str: [Char:*]) #ct -> Void {
		@comptimePrint(str);
	}


	impl std.IWriterBackend {
		write = (this mut, str: [Byte:*]) #rtDiff -> Void {
			when(@isComptime()){
				this.write(str);

			}else{
				@panic("std.ComptimeStdoutWriter cannot write at runtime");
			}
		},
	}
}