@setModuleName("std");

def std = @import("std");


type FileWriter = struct #pub {
	when switch(@config.platform){
		case(std.Platform.FREESTANDING){
			@comptimeError("`std.FileWriter` is not supported in frestanding platform target");
		}

		case(std.Platform.LINUX){
			type FileHandle = alias std.platform.linux.FileDescriptor;
		}

		case(std.Platform.PANTHER_VM){
			type FileHandle = alias std.platform.pantherVM.FileHandle;
		}

		case(std.Platform.WINDOWS){
			type FileHandle = alias std.platform.windows.Handle;
		}
	}


	func new = (handle: FileHandle) #rt -> (output: FileWriter) {
		output.handle = copy handle;
		return...;
	}


	func createStdout = () #rt -> (output: FileWriter) {
		when switch(@config.platform){
			case(std.Platform.FREESTANDING){
				@comptimeError("`std.FileWriter` is not supported in freestanding platform target");
			}

			case(std.Platform.LINUX){
				output = new FileWriter(std.platform.linux.STDOUT);
			}

			case(std.Platform.PANTHER_VM){
				output = new FileWriter(std.platform.pantherVM.STDOUT);
			}

			case(std.Platform.WINDOWS){
				output = new FileWriter(std.platform.windows.getStdHandle(std.platform.windows.StdHandle.OUTPUT));
			}
		}
		return...;
	}




	func write = (this mut, str: [Char:*]) #rt -> Void {
		// TODO(FUTURE): error handling
		when switch(@config.platform){
			case(std.Platform.FREESTANDING){
				@comptimeError("`std.FileWriter` is not supported in freestanding platform target");
			}

			case(std.Platform.LINUX){
				_ = std.platform.linux.write(this.handle, str);
			}

			case(std.Platform.PANTHER_VM){
				try std.platform.pantherVM.fileWrite(this.handle, str) else<err> {};
			}

			case(std.Platform.WINDOWS){
				try std.platform.windows.ntWriteFile(this.handle, str) else<nt_status> {};
			}
		}
	}

	func flush = (this mut) -> Void {
		// not buffered, do nothing
	}
	


	impl std.IWriter {
		write = (this mut, str: [Char:*]) #rtDiff -> Void {
			when(@isComptime()){
				unreachable("`std.FileWriter` cannot write at comptime");
				
			}else{
				this.write(str);
			}
		},

		flush = flush,
	}


	///////////////////////////////////
	// priv

	const handle: FileHandle #priv;
}