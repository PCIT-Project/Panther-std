@setModuleName("std");

def std = @import("std");


type FileWriter = struct #pub {
	when switch(@config.platform){
		case(std.Platform.WINDOWS){
			type FileHandle = alias std.os.windows.Handle;
		}

		case(std.Platform.LINUX){
			type FileHandle = alias std.os.linux.FileDescriptor;
		}
	}


	func new = (handle: FileHandle) #rt -> (output: FileWriter) {
		output.handle = copy handle;
		return...;
	}


	func createStdout = () #rt -> (output: FileWriter) {
		when switch(@config.platform){
			case(std.Platform.WINDOWS){
				output = new FileWriter(std.os.windows.getStdHandle(std.os.windows.StdHandle.OUTPUT));
			}

			case(std.Platform.LINUX){
				output = new FileWriter(std.os.linux.STDOUT);
			}
		}
		return...;
	}




	func write = (this mut, str: [Char:*]) #rt -> Void {
		// TODO(FUTURE): error handling
		when switch(@config.platform){
			case(std.Platform.WINDOWS){
				try std.os.windows.ntWriteFile(this.handle, str) else<nt_status> {};
			}

			case(std.Platform.LINUX){
				_ = std.os.linux.write(this.handle, str);
			}
		}
	}

	func flush = (this mut) -> Void {
		// not buffered, do nothing
	}


	impl std.IWriter {
		write = (this mut, str: [Char:*]) #rtDiff -> Void {
			when(@isComptime()){
				unreachable("std.FileWriter cannot write at comptime");
				
			}else{
				this.write(str);
			}
		},

		flush = flush,
	}


	///////////////////////////////////
	// priv

	when switch(@config.platform){
		case(std.Platform.WINDOWS){
			const handle: std.os.windows.Handle #priv;
		}

		case(std.Platform.LINUX){
			const handle: std.os.linux.FileDescriptor #priv;
		}
	}
}