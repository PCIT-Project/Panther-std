@setModuleName("std");

def std = @import("std");


type PolymorphicTag = struct #pub {}

func getInterfacePtrMapUnderlyingType = <{TargetType: Type, Interface: Type}> () #pub -> TypeID {
	when(@getTypeID<{TargetType}>() == @getTypeID<{PolymorphicTag}>()){
		return @getTypeID<{impl(*mut:Interface)}>();
	}else{
		return @getTypeID<{impl(TargetType:Interface)}>();
	}
}


// TODO(FUTURE): remove when implicit conversion is added
func _temp_asInterfacePtrMap = <{Interface: Type}> (value: $T mut) #pub -> impl*mut(impl(T:Interface):Interface) {
	return value as impl(T:Interface) as impl*mut(impl(T:Interface):Interface);
}