@setModuleName("std.bit");

def std #private = @import("std");



func asBuffer = (from: $From*) -> [Byte:*] {
	unsafe{
		return new [Byte:*](bitCast<{Byte*}>(from as RawPtr), std.types.numBytes<{From}>());
	}
}
func asBuffer = (from: $From*mut) -> [Byte:*mut] {
	unsafe{
		return new [Byte:*mut](bitCast<{Byte*mut}>(from as RawPtr), std.types.numBytes<{From}>());
	}
}


func bitCast = <{To: Type}> (from: $From) #unsafe -> To {
	unsafe{
		return @_bitCast<{From, To}>(from);
	}
}



func bitCeil = (num: $Integral) -> Integral {
	@comptimeAssert(std.types.isUnsignedIntegral<{Integral}>(), "std.bit.bitWidth only accepts unsigned integrals");

	if(num != 0){
		return 1 as Integral << bitWidth(num - 1) as type(std.types.getShiftValueTypeID<{Integral}>());
	}else{
		return 0;
	}
}

func bitFloor = (num: $Integral) -> Integral {
	@comptimeAssert(std.types.isUnsignedIntegral<{Integral}>(), "std.bit.bitWidth only accepts unsigned integrals");

	if(num != 0){
		return 1 as Integral << (bitWidth(num) - 1) as type(std.types.getShiftValueTypeID<{Integral}>());
	}else{
		return 0;
	}
}


func bitReverse = (num: $Integral) -> Integral {
	return @_bitReverse<{Integral}>(num);
}

func bitWidth = (num: $Integral) -> Integral {
	@comptimeAssert(std.types.isUnsignedIntegral<{Integral}>(), "std.bit.bitWidth only accepts unsigned integrals");
	return std.types.numBits<{Integral, false}>() - countLZero(num);
}

func byteSwap = (num: $Integral) -> Integral {
	return @_byteSwap<{Integral}>(num);
}


func countLZero = (num: $Integral) -> Integral {
	return @_ctlz<{Integral}>(num);
}

func countRZero = (num: $Integral) -> Integral {
	return @_cttz<{Integral}>(num);
}

func countLOne = (num: $Integral) -> Integral {
	return @_ctlz<{Integral}>(~num);
}

func countROne = (num: $Integral) -> Integral {
	return @_cttz<{Integral}>(~num);
}



func rotl = (num: $Integral, ammount: Int) -> Integral {
	def NUM_DIGITS: USize = std.types.numDigits<{Integral}>();
	type ShiftType = alias type(std.types.getShiftValueTypeID<{Integral}>());

	const ammount_normalized: Int = (ammount as USize % NUM_DIGITS) as Int;

	if(ammount_normalized > 0){
		return (num << ammount_normalized as ShiftType)
			| (num >> (NUM_DIGITS as Int - ammount_normalized) as ShiftType);

	}else if(ammount_normalized == 0){
		return copy num;

	}else{
		// rotr
		return (num >> ammount_normalized as ShiftType)
			| (num << (NUM_DIGITS as Int - ammount_normalized) as ShiftType);
	}
}

func rotr = (num: $Integral, ammount: Int) -> Integral {
	def NUM_DIGITS: USize = std.types.numDigits<{Integral}>();
	type ShiftType = alias type(std.types.getShiftValueTypeID<{Integral}>());

	const ammount_normalized: Int = (ammount as USize % NUM_DIGITS) as Int;

	if(ammount_normalized > 0){
		return (num >> ammount_normalized as ShiftType)
			| (num << (NUM_DIGITS as Int - ammount_normalized) as ShiftType);

	}else if(ammount_normalized == 0){
		return copy num;

	}else{
		// rotl
		return (num << ammount_normalized as ShiftType)
			| (num >> (NUM_DIGITS as Int - ammount_normalized) as ShiftType);
	}
}



func hasFlag = (value: $T, flag: T) -> Bool {
	unsafe{
		return value & flag != std.bitCast<{T}>(0 as type(std.types.getUnderlyingTypeID<{T}>()));
	}
}

func popCount = (num: $Integral) -> Integral {
	return @_ctPop<{Integral}>(num);
}


