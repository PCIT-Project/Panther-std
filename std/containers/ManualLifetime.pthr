@setModuleName("std");

def std #priv = @import("std");


type ManualLifetime = struct <{T: Type}> {
	func get       = (this)     #unsafe -> T*       { return std.bitCast<{T*}>(&this.data.value);       }
	func get       = (this mut) #unsafe -> T*mut    { return std.bitCast<{T*mut}>(&this.data.value);    }
	func getUninit = (this mut) #unsafe -> T*uninit { return std.bitCast<{T*uninit}>(&this.data.value); }
	

	///////////////////////////////////
	// private

	type Data = union #priv #untagged #manualLifetime {
		value: T,
	}

	var data: Data #priv;
}
