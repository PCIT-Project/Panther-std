@setModuleName("std.debug");

def std = @import("std");

func assert = (cond: Bool, message: [Char:*]) #pub -> Void {
	if(cond == false){
		when(@config.mode == std.Mode.DEBUG){
			when(std.platform.SUPPORTS_CMD){
				print("\e[37m\e[41m");
				print(message);
				print("\e[0m\n");
			}

			@breakpoint();

		}else{
			unreachable("Failed assert");
		}
	}
}


func assert = (cond: Bool) #pub -> Void {
	if(cond == false){
		when(@config.mode == std.Mode.DEBUG){
			when(std.platform.SUPPORTS_CMD){
				println("\e[37m\e[41mFailed assert\e[0m");
			}

			@breakpoint();
			
		}else{
			unreachable("Failed assert");
		}
	}
}




when(std.platform.SUPPORTS_CMD){
	func print = (str: [Char:*]) #pub #rtDiff -> Void {
		when(@isComptime()){
			@ctPrint(str);

		}else{
			when switch(@config.platform){
				case(std.Platform.FREESTANDING){
					@comptimeError("`std.debug.print` is not supported in freestanding platform target");
				}

				case(std.Platform.LINUX){
					_ = std.platform.linux.write(std.platform.linux.STDOUT, str);
				}

				case(std.Platform.PANTHER_VM){
					try std.platform.pantherVM.fileWrite(std.platform.pantherVM.STDOUT, str) else<err> {};
				}

				case(std.Platform.WINDOWS){
					const heap_handle: std.platform.windows.Handle = std.platform.windows.getProcessHeap();

					const alloc_buffer: [Char:*mut] = std.platform.windows.heapAlloc<{Char}>(
						heap_handle, std.platform.windows.HeapAllocFlags.NONE, str.size() + 1
					);
					defer{
						std.platform.windows.heapFree(
							heap_handle, std.platform.windows.HeapFreeFlags.NONE, alloc_buffer.data().?
						);
					}

					std.mem.copyBuffer(new [Char:*mut](copy alloc_buffer.data().?, str.size()), str);
					alloc_buffer[str.size()].* = '\0';

					const stdout: std.platform.windows.Handle = std.platform.windows.getStdHandle(
						std.platform.windows.StdHandle.OUTPUT
					);

					try std.platform.windows.ntWriteFile(stdout, str) else <nt_status> {}; // TODO(FUTURE): error handling
					std.platform.windows.outputDebugStringA(
						new [Char:*mut;'\0'](copy alloc_buffer.data().?, str.size())
					);
				}
			}
		}
	}


	func print = (format_str: std.fmt.FmtString, args: $$...) #pub -> Void {
		var debug_writer = new std.DebugStdoutWriter();
		var writer = new std.Writer<{std.DebugStdoutWriter}>(debug_writer);
		writer.write(format_str, args...);
	}




	func println = (str: [Char:*]) #pub #rtDiff -> Void {
		when(@isComptime()){
			@ctPrintln(str);

		}else{
			when switch(@config.platform){
				case(std.Platform.FREESTANDING){
					@abort("std.debug.println isn't supported in freestanding platform target");
				}

				case(std.Platform.LINUX){
					_ = std.platform.linux.write(std.platform.linux.STDOUT, str);

					const newline: Char = '\n';
					_ = std.platform.linux.write(std.platform.linux.STDOUT, new [Char:*](&newline, 1));
				}

				case(std.Platform.PANTHER_VM){
					try std.platform.pantherVM.fileWrite(std.platform.pantherVM.STDOUT, str) else<err> {};

					const newline: Char = '\n';
					try std.platform.pantherVM.fileWrite(
						std.platform.pantherVM.STDOUT, new [Char:*](&newline, 1)
					) else<err> {};
				}

				case(std.Platform.WINDOWS){
					const heap_handle: std.platform.windows.Handle = std.platform.windows.getProcessHeap();

					const alloc_buffer: [Char:*mut] = std.platform.windows.heapAlloc<{Char}>(
						heap_handle, std.platform.windows.HeapAllocFlags.NONE, str.size() + 2
					);
					defer{
						std.platform.windows.heapFree(
							heap_handle, std.platform.windows.HeapFreeFlags.NONE, alloc_buffer.data().?
						);
					}

					std.mem.copyBuffer(new [Char:*mut](copy alloc_buffer.data().?, str.size()), str);
					alloc_buffer[str.size()].* = '\n';
					alloc_buffer[str.size() + 1].* = '\0';

					const stdout: std.platform.windows.Handle = std.platform.windows.getStdHandle(
						std.platform.windows.StdHandle.OUTPUT
					);

					const created_str = new [Char:*mut;'\0'](copy alloc_buffer.data().?, str.size() + 1);

					// TODO(FUTURE): error handling
					try std.platform.windows.ntWriteFile(stdout, created_str) else <nt_status> {};
					std.platform.windows.outputDebugStringA(created_str);
				}
			}
		}
	}


	func println = (format_str: std.fmt.FmtString, args: $$...) #pub -> Void {
		var debug_writer = new std.DebugStdoutWriter();
		var writer = new std.Writer<{std.DebugStdoutWriter}>(debug_writer);

		writer.write(format_str, args...);
		writer.write('\n');
	}

}else{
	func print = (str: [Char:*]) #pub #rtDiff -> Void = delete("Not supported in this platform target");
	func print = (format_str: std.fmt.FmtString, args: $$...) #pub -> Void =
		delete("Not supported in this platform target");

	func println = (str: [Char:*]) #pub #rtDiff -> Void = delete("Not supported in this platform target");
	func println = (format_str: std.fmt.FmtString, args: $$...) #pub -> Void =
		delete("Not supported in this platform target");

}


