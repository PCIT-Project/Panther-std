@setModuleName("std.heap");

def std #private = @import("std");


type PageAllocator = struct {

	func alloc = (size: USize, alignment: UI32) #rtDiff -> [Byte:*mut] {
		std.debug.assert(size != 0, "Cannot allocate a size of 0");
		std.debug.assert(alignment > 0 && std.math.isPowOf2(alignment), "Inavlid alignment");

		when(@isComptime()){
			const ptr: RawPtr = @_ctAlloc(std.math.ceilToMultiple(size, std.heap.pageSize()), alignment);

			unsafe{
				return new [Byte:*mut](std.bitCast<{Byte*mut}>(ptr), copy size);
			}

		}else{
			return rt_alloc(size, alignment);
		}
	}


	func allocResize = (buffer: [Byte:*], new_size: USize) #rtDiff -> Void <Void> {
		when(@isComptime()){
			error;
		}else{
			try rt_alloc_resize(buffer, new_size) else { error; };
		}
	}


	func dealloc = (buffer: [Byte:*]) #rtDiff -> Void {
		when(@isComptime()){
			@_ctDealloc(buffer.data() as RawPtr);
		}else{
			rt_dealloc(buffer);
		}
	}

	


	impl std.mem.IAllocator {
		alloc       = (this mut, size: USize, alignment: UI32) -> [Byte:*mut] { return alloc(size, alignment); },
		allocResize = (this mut, buffer: [Byte:*], alignment: UI32, new_size: USize) -> Void <Void> {
			try allocResize(buffer, new_size) else { error; }; 
		},
		dealloc     = (this mut, buffer: [Byte:*], alignment: UI32) -> Void { dealloc(buffer); },
	}


	impl std.mem.IAllocatorRT {
		alloc       = (this mut, size: USize, alignment: UI32) -> [Byte:*mut] { return alloc(size, alignment); },
		allocResize = (this mut, buffer: [Byte:*], alignment: UI32, new_size: USize) -> Void <Void> {
			try allocResize(buffer, new_size) else { error; }; 
		},
		dealloc     = (this mut, buffer: [Byte:*], alignment: UI32) -> Void { dealloc(buffer); },
	}



	///////////////////////////////////
	// private



	func rt_alloc = (size: USize, alignment: UI32) #rt #private -> [Byte:*mut] {
		std.debug.assert(
			alignment as USize <= std.heap.pageSize(),
			"This alignment is currently unsupported by std.heap.PageAllocator"
		);

		when switch(@config.platform){
			case(std.Platform.FREESTANDING){
				@comptimeError("`std.heap.PageAllocator` is unsupported in freestanding platform target");
			}

			case(std.Platform.LINUX){
				const allocated_addr: RawPtr = try std.platform.linux.mmap(
					null,
					std.math.ceilToMultiple(size, std.heap.pageSize()),
					std.platform.linux.ProtectionFlags.READ | std.platform.linux.ProtectionFlags.WRITE,
					std.platform.linux.MapFlags.PRIVATE | std.platform.linux.MapFlags.ANONYMOUS,
					-1 as std.platform.linux.FileDescriptor,
					0
				) else<errno: std.platform.linux.Errno> {
					switch(errno){
						case(std.platform.linux.Errno.ACCES){
							unreachable("std.heap.PageAllocator failed to allocate - Errno.ACCES");
						}

						case(std.platform.linux.Errno.AGAIN){
							unreachable("std.heap.PageAllocator failed to allocate - Errno.AGAIN");
						}

						case(std.platform.linux.Errno.BADF){
							unreachable("std.heap.PageAllocator failed to allocate - Errno.BADF");
						}

						case(std.platform.linux.Errno.EXIST){
							unreachable("std.heap.PageAllocator failed to allocate - Errno.EXIST");
						}

						case(std.platform.linux.Errno.INVAL){
							unreachable("std.heap.PageAllocator failed to allocate - Errno.INVAL");
						}

						case(std.platform.linux.Errno.NFILE){
							unreachable("std.heap.PageAllocator failed to allocate - Errno.NFILE");
						}

						case(std.platform.linux.Errno.NODEV){
							unreachable("std.heap.PageAllocator failed to allocate - Errno.NODEV");
						}

						case(std.platform.linux.Errno.NOMEM){
							unreachable("std.heap.PageAllocator failed to allocate - Errno.NOMEM");
						}

						case(std.platform.linux.Errno.OVERFLOW){
							unreachable("std.heap.PageAllocator failed to allocate - Errno.OVERFLOW");
						}

						case(std.platform.linux.Errno.PERM){
							unreachable("std.heap.PageAllocator failed to allocate - Errno.PERM");
						}

						case(std.platform.linux.Errno.TXTBSY){
							unreachable("std.heap.PageAllocator failed to allocate - Errno.TXTBSY");
						}

						else{
							unreachable("std.heap.PageAllocator failed to allocate - Unexpected error");
						}
					}
				};

				unsafe{
					return new [Byte:*mut](std.bitCast<{Byte*mut}>(allocated_addr), copy size);
				}
			}

			case(std.Platform.PANTHER_VM){
				return std.platform.pantherVM.memPageAlloc(size, alignment);
			}

			case(std.Platform.WINDOWS){
				const allocated_addr: RawPtr = uninit;
				[allocated_addr, _] = try std.platform.windows.ntAllocateVirtualMemory(
					std.platform.windows.ntCurrentProcess(),
					null,
					0,
					size,
					std.platform.windows.AllocationTypeFlags.COMMIT | std.platform.windows.AllocationTypeFlags.RESERVE,
					std.platform.windows.AllocationProtectionFlags.READWRITE
				) else<nt_status: std.platform.windows.NTStatus> {
					switch(nt_status){
						case(std.platform.windows.NTStatus.ACCESS_DENIED){
							unreachable("std.heap.PageAllocator failed to allocate - NTStatus.ACCESS_DENIED");
						}

						case(std.platform.windows.NTStatus.ALREADY_COMMITTED){
							unreachable("std.heap.PageAllocator failed to allocate - NTStatus.ALREADY_COMMITTED");
						}

						case(std.platform.windows.NTStatus.COMMITMENT_LIMIT){
							unreachable("std.heap.PageAllocator failed to allocate - NTStatus.COMMITMENT_LIMIT");
						}

						case(std.platform.windows.NTStatus.CONFLICTING_ADDRESSES){
							unreachable("std.heap.PageAllocator failed to allocate - NTStatus.CONFLICTING_ADDRESSES");
						}

						case(std.platform.windows.NTStatus.INSUFFICIENT_RESOURCES){
							unreachable("std.heap.PageAllocator failed to allocate - NTStatus.INSUFFICIENT_RESOURCES");
						}

						case(std.platform.windows.NTStatus.INVALID_HANDLE){
							unreachable("std.heap.PageAllocator failed to allocate - NTStatus.INVALID_HANDLE");
						}

						case(std.platform.windows.NTStatus.INVALID_PAGE_PROTECTION){
							unreachable("std.heap.PageAllocator failed to allocate - NTStatus.INVALID_PAGE_PROTECTION");
						}

						case(std.platform.windows.NTStatus.NO_MEMORY){
							unreachable("std.heap.PageAllocator failed to allocate - NTStatus.NO_MEMORY");
						}

						case(std.platform.windows.NTStatus.OBJECT_TYPE_MISMATCH){
							unreachable("std.heap.PageAllocator failed to allocate - NTStatus.OBJECT_TYPE_MISMATCH");
						}

						case(std.platform.windows.NTStatus.PROCESS_IS_TERMINATING){
							unreachable("std.heap.PageAllocator failed to allocate - NTStatus.PROCESS_IS_TERMINATING");
						}

						else{
							unreachable("std.heap.PageAllocator failed to allocate - Unexpected error");
						}
					}
				};

				unsafe{
					return new [Byte:*mut](std.bitCast<{Byte*mut}>(allocated_addr), copy size);
				}
			}
		}
	}


	func rt_alloc_resize = (buffer: [Byte:*], new_size: USize) #rt #private -> Void <Void> {
		if(buffer.size() < new_size){ // grow
			if(std.math.ceilToMultiple(buffer.size(), std.heap.pageSize()) < new_size){ error; }
			return;
			
		}else if(buffer.size() > new_size){ // shrink
			if(std.math.floorToMultiple(buffer.size(), std.heap.pageSize()) > new_size){ error; }
			return;
			
		}else{ // same size
			return;
		}
	}



	func rt_dealloc = (buffer: [Byte:*]) #rt #private -> Void {
		when switch(@config.platform){
			case(std.Platform.FREESTANDING){
				@comptimeError("`std.heap.PageAllocator` is unsupported in freestanding platform target");
			}
			
			case(std.Platform.LINUX){
				const allocation_size: USize = std.math.ceilToMultiple(buffer.size(), std.heap.pageSize());

				try std.platform.linux.munmap(buffer.data() as RawPtr, allocation_size)
					else<errno: std.platform.linux.Errno>
				{
					switch(errno){
						case(std.platform.linux.Errno.INVAL){
							unreachable("std.heap.PageAllocator failed to deallocate - Errno.INVAL");
						}

						else{
							unreachable("std.heap.PageAllocator failed to deallocate - Unexpected error");
						}
					}
				};
			}

			case(std.Platform.PANTHER_VM){
				try std.platform.pantherVM.memPageDealloc(buffer) else<err: std.platform.pantherVM.DeallocError> {
					switch(err){
						case(std.platform.pantherVM.DeallocError.NOT_ALLOCATED){
							unreachable("std.heap.PageAllocator failed to deallocate - DeallocError.NOT_ALLOCATED");
						}

						case(std.platform.pantherVM.DeallocError.ALREADY_DEALLOCATED){
							unreachable(
								"std.heap.PageAllocator failed to deallocate - DeallocError.ALREADY_DEALLOCATED"
							);
						}
					}
				};
			}

			case(std.Platform.WINDOWS){
				[_, _] = try std.platform.windows.ntFreeVirtualMemory(
					std.platform.windows.ntCurrentProcess(),
					buffer.data() as RawPtr,
					0,
					std.platform.windows.FreeTypeFlags.RELEASE
				) else<nt_status: std.platform.windows.NTStatus> {
					switch(nt_status){
						case(std.platform.windows.NTStatus.ACCESS_DENIED){
							unreachable("std.heap.PageAllocator failed to deallocate - NTStatus.ACCESS_DENIED");
						}

						case(std.platform.windows.NTStatus.INVALID_HANDLE){
							unreachable("std.heap.PageAllocator failed to deallocate - NTStatus.INVALID_HANDLE");
						}

						case(std.platform.windows.NTStatus.OBJECT_TYPE_MISMATCH){
							unreachable("std.heap.PageAllocator failed to deallocate - NTStatus.OBJECT_TYPE_MISMATCH");
						}

						case(std.platform.windows.NTStatus.MEMORY_NOT_ALLOCATED){
							unreachable("std.heap.PageAllocator failed to deallocate - NTStatus.MEMORY_NOT_ALLOCATED");
						}

						case(std.platform.windows.NTStatus.FREE_VM_NOT_AT_BASE){
							unreachable("std.heap.PageAllocator failed to deallocate - NTStatus.FREE_VM_NOT_AT_BASE");
						}

						else{
							unreachable("std.heap.PageAllocator failed to deallocate - Unexpected error");
						}
					}
				};
			}
		}
	}


}
