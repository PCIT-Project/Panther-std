@setModuleName("std.heap");

def std #priv = @import("std");


type ComptimeAllocator = struct {
	func alloc = (this mut, size: USize, alignment: UI32) #ct -> [Byte:*mut] {
		const ptr: RawPtr = @ctAlloc(size, alignment);

		unsafe{
			return new [Byte:*mut](std.bitCast<{Byte*mut}>(ptr), copy size);
		}
	}


	func allocResize = (this mut, buffer: [Byte:*], new_size: USize) #ct -> Void <Void> {
		error;
	}



	func dealloc = (this mut, buffer: [Byte:*]) #ct -> Void {
		@ctDealloc(buffer.data() as RawPtr);
	}



	impl std.mem.IAllocator {
		alloc       = alloc,
		allocResize = allocResize,
		dealloc     = dealloc,
	}

	impl std.mem.IAllocatorCT {
		alloc       = alloc,
		allocResize = allocResize,
		dealloc     = dealloc,
	}
}
