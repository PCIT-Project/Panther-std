@setModuleName("std.platform.windows");

def std = @import("std");


//////////////////////////////////////////////////////////////////////
// types

//////////////////
// https://learn.microsoft.com/en-us/windows/win32/winprog/windows-data-types

type DWORD     = alias UI32;
type HANDLE    = alias RawPtr;
type HINSTANCE = alias RawPtr;
type LONG_PTR  = alias ISize;
type LPCSTR    = alias Char*; // null terminated string
type LPDWORD   = alias DWORD*mut;
type LPVOID    = alias RawPtr;
type LPCVOID   = alias RawPtr;
type PSIZE_T   = alias SIZE_T*mut;
type PULONG    = alias ULONG*mut;
type PVOID     = alias RawPtr;
type SIZE_T    = alias USize;
type UINT      = alias CUInt;
type ULONG     = alias CULong;
type ULONG_PTR = alias USize;



//////////////////
// https://learn.microsoft.com/en-us/windows/win32/api/winnt/ns-winnt-large_integer-r1

type LARGE_INTEGER  = alias I64;
type PLARGE_INTEGER = alias I64*mut;



//////////////////
// https://learn.microsoft.com/en-us/windows/win32/api/minwinbase/ns-minwinbase-overlapped

type OVERLAPPED = struct #ordered {
	var Internal       : ULONG_PTR;
	var InternalHigh   : ULONG_PTR;
	var DUMMYUNIONNAME : _DUMMYUNIONNAME;
	var hEvent         : HANDLE;

	type _DUMMYUNIONNAME = union {
		type _DUMMYSTRUCTNAME = struct {
			var Offset     : DWORD;
			var OffsetHigh : DWORD;
		}

		DUMMYSTRUCTNAME: _DUMMYSTRUCTNAME,
		Pointer: PVOID,
	}
}

type LPOVERLAPPED = alias OVERLAPPED*mut;


//////////////////
// IO

type IO_STATUS_BLOCK = struct #ordered {
	var Status: NTSTATUS; // actually union, but the other member is reserved
	var Information: ULONG_PTR;
}

type PIO_STATUS_BLOCK = alias IO_STATUS_BLOCK*mut;


type IO_APC_ROUTINE = alias func(PVOID, PIO_STATUS_BLOCK, ULONG) #rt #callConv(@pthr.CallingConvention.WIN_API)
	-> Void;

type PIO_APC_ROUTINE = alias IO_APC_ROUTINE?;


//////////////////
// misc

type NTSTATUS = alias UI32;




//////////////////////////////////////////////////////////////////////
// vars

func handle_id_from_spec = (spec: I32) -> UI32 {
	unsafe{ return std.bitCast<{UI32}>(spec); }
}

def STD_INPUT_HANDLE  : DWORD = handle_id_from_spec(-10);
def STD_OUTPUT_HANDLE : DWORD = handle_id_from_spec(-11);
def STD_ERROR_HANDLE  : DWORD = handle_id_from_spec(-12);



//////////////////////////////////////////////////////////////////////
// ntdll

func NtAllocateVirtualMemory = (
	ProcessHandle  : HANDLE,
	BaseAddress    : PVOID*mut?,
	ZeroBits       : ULONG_PTR,
	RegionSize     : PSIZE_T,
	AllocationType : ULONG,
	Protect        : ULONG,
) #callConv(@pthr.CallingConvention.WIN_API) -> NTSTATUS = extern(@pthr.Language.C);

func NtCurrentProcess = () #rt -> HANDLE {
	unsafe{
		return std.bitCast<{HANDLE}>(-1 as LONG_PTR);
	}
}

func NtCurrentThread = () #rt -> HANDLE {
	unsafe{
		return std.bitCast<{HANDLE}>(-2 as LONG_PTR);
	}
}

func NtFreeVirtualMemory = (
	ProcessHandle : HANDLE,
	BaseAddress   : PVOID*mut?,
	RegionSize    : PSIZE_T,
	FreeType      : ULONG,
) #callConv(@pthr.CallingConvention.WIN_API) -> NTSTATUS = extern(@pthr.Language.C);


func NtWriteFile = (
	FileHandle: HANDLE,
	Event: HANDLE,
	ApcRoutine: PIO_APC_ROUTINE,
	ApcContext: PVOID,
	IoStatusBlock: PIO_STATUS_BLOCK,
	Buffer: PVOID,
	Length: ULONG,
	ByteOffset: PLARGE_INTEGER?,
	Key: PULONG?,
) #callConv(@pthr.CallingConvention.WIN_API) -> NTSTATUS = extern(@pthr.Language.C);



//////////////////////////////////////////////////////////////////////
// kernel32

func ExitProcess = 
	(uExitCode: UINT) #noReturn #callConv(@pthr.CallingConvention.WIN_API) -> Void = extern(@pthr.Language.C);

func GetLastError = () #callConv(@pthr.CallingConvention.WIN_API) -> DWORD = extern(@pthr.Language.C);

func GetStdHandle = 
	(nStdHandle: DWORD) #callConv(@pthr.CallingConvention.WIN_API) -> HANDLE = extern(@pthr.Language.C);

func GetProcessHeap = () #callConv(@pthr.CallingConvention.WIN_API) -> HANDLE = extern(@pthr.Language.C);

func HeapAlloc = (
	hHeap: HANDLE, dwFlags: DWORD, dwBytes: SIZE_T
) #callConv(@pthr.CallingConvention.WIN_API) -> LPVOID = extern(@pthr.Language.C);

func HeapFree = (
	hHeap: HANDLE, dwFlags: DWORD, lpMem: LPVOID
) #callConv(@pthr.CallingConvention.WIN_API) -> Void = extern(@pthr.Language.C);

func OutputDebugStringA =
	(lpOutputString: LPCSTR) #callConv(@pthr.CallingConvention.WIN_API) -> Void = extern(@pthr.Language.C);

// func SwitchToThread = () #callConv(@pthr.CallingConvention.WIN_API) -> Bool32 = extern(@pthr.Language.C);



