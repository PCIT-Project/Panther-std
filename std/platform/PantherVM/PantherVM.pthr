@setModuleName("std.platform.pantherVM");

def std = @import("std");
def native = @import("./native.pthr");


type FileHandle = alias #distinct UI32;

type DeallocError = enum(UI32) {
	NOT_ALLOCATED = 0,
	ALREADY_DEALLOCATED = 1,
}

type FileWriteError = enum(UI32) {
	INVALID_HANDLE = 0,
	FILE_NOT_WRITABLE = 1,
}



def STDIN = new FileHandle(0);
def STDOUT = new FileHandle(1);
def STDERR = new FileHandle(2);


func memPageAlloc = (size: USize, alignment: UI32) #rt -> [Byte:*mut] {
	const allocated_buffer_ptr: RawPtr = native.pantherVMMemPageAlloc(size, alignment);
	unsafe{
		return new [Byte:*mut](std.bitCast<{Byte*mut}>(allocated_buffer_ptr), copy size);
	}
}

func memPageDealloc = (buffer: [Byte:*]) #rt -> Void <err: DeallocError> {
	unsafe{
		if(native.pantherVMMemPageDealloc(buffer.data().?, buffer.size(), std.bitCast<{UI32*mut}>(&err))){ error...; }
	}
}

func fileWrite = (file_handle: FileHandle, str: [Char:*]) #rt -> Void <err: FileWriteError> {
	if(str.size() == 0){ return; }
	unsafe{
		if(native.pantherVMFileWrite(file_handle as UI32, str.data().?, str.size(), std.bitCast<{UI32*mut}>(&err))){
			error...;
		}
	}
}
