@setModuleName("std.platform.linux");

def std #priv = @import("std");

def native = @import("./native.pthr");


///////////////////////////////////
// types

type FileDescriptor = alias #distinct CInt;
type Offset = alias #distinct I64; // off_t

type Mode = alias #distinct CInt;


//////////////////////////////////////////////////////////////////////
// enums / vars

def STDIN    = 0 as FileDescriptor;
def STDOUT   = 1 as FileDescriptor;
def STDERR   = 2 as FileDescriptor;
def AT_FDCWD = -100 as FileDescriptor;

type Errno = alias native.Errno;

type ProtectionFlags = enum(CInt) {
	NONE  = 0x0,
	READ  = 0x1,
	WRITE = 0x2,
	EXEC  = 0x4,
}

type MapFlags = enum(CInt) {
	def MAP_HUGE_SHIFT #priv = 26;

	SHARED            = 0x01,
	PRIVATE           = 0x02,
	SHARED_VALIDATE   = 0x03,

	FIXED             = 0x10,
	ANONYMOUS         = 0x20,
	GROWSDOWN         = 0x100,
	MAP_LOCKED        = 0x2000,
	MAP_NORESERVE     = 0x4000,
	MAP_POPULATE      = 0x8000,
	MAP_NONBLOCK      = 0x10000,
	MAP_STACK         = 0x20000,
	HUGETLB           = 0x40000,
	MAP_SYNC          = 0x80000,
	FIXED_NOREPLACE   = 0x100000,
	MAP_UNINITIALIZED = 0x4000000,
	HUGE_16KB         = 14 << MAP_HUGE_SHIFT,
	HUGE_64KB         = 16 << MAP_HUGE_SHIFT,
	HUGE_512KB        = 19 << MAP_HUGE_SHIFT,
	HUGE_1MB          = 20 << MAP_HUGE_SHIFT,
	HUGE_2MB          = 21 << MAP_HUGE_SHIFT,
	HUGE_8MB          = 23 << MAP_HUGE_SHIFT,
	HUGE_16MB         = 24 << MAP_HUGE_SHIFT,
	HUGE_32MB         = 25 << MAP_HUGE_SHIFT,
	HUGE_256MB        = 28 << MAP_HUGE_SHIFT,
	HUGE_512MB        = 29 << MAP_HUGE_SHIFT,
	HUGE_1GB          = 30 << MAP_HUGE_SHIFT,
	HUGE_2GB          = 31 << MAP_HUGE_SHIFT,
	// HUGE_16GB         = 34 << MAP_HUGE_SHIFT,
}


type O = enum(CInt) {
	NONE = 0,

	RDONLY = 0o00000000, // readonly
	WRONLY = 0o00000001, // writeonly
	RDWR   = 0o00000002, // read/write

	CREAT     = 0o00000100,
	EXCL      = 0o00000200,
	NOCTTY    = 0o00000400,
	TRUNC     = 0o00001000,
	DIRECTORY = 0o00200000, // must be a directory
	NOFOLLOW  = 0o00400000, // don't follow links
	CLOEXEC   = 0o02000000, // enable the close-on-exec flag
	TMPFILE   = 0o020000000 | DIRECTORY,

}

type Permissions = enum(CInt) {
	IRWXU = 0o00700, // user (file owner) has read, write, and execute permission
	IRUSR = 0o00400, // user has read permission
	IWUSR = 0o00200, // user has write permission
	IXUSR = 0o00100, // user has execute permission

	IRWXG = 0o00070, // group has read, write, and execute permission
	IRGRP = 0o00040, // group has read permission
	IWGRP = 0o00020, // group has write permission
	IXGRP = 0o00010, // group has execute permission

	IRWXO = 0o00007, // others have read, write, and execute permission
	IROTH = 0o00004, // others have read permission
	IWOTH = 0o00002, // others have write permission
	IXOTH = 0o00001, // others have execute permission

	// According to POSIX, the effect when other bits are set in
	// mode is unspecified.  On Linux, the following bits are also
	// honored in mode:

	ISUID = 0o0004000, // set-user-ID bit
	ISGID = 0o0002000, // set-group-ID bit (see inode(7)).
	ISVTX = 0o0001000, // sticky bit (see inode(7)).
}



//////////////////////////////////////////////////////////////////////
// functions


func close = (file_descriptor: FileDescriptor) #rt -> Void <Errno> {
	const res: UI64 = native.syscall(native.SyscallCode.CLOSE, file_descriptor as UI64);

	const e: Errno = native.calcErrno(res);
	if(e == Errno.SUCCESS){ return; }
	error copy e;	
}


func exit = (exit_code: CInt) #rt #noReturn -> Void {
	_ = native.syscall(native.SyscallCode.EXIT, exit_code as UI64);
}


func mmap = (
	addr: RawPtr, length: USize, prot: ProtectionFlags, flags: MapFlags, fd: FileDescriptor, offset: Offset
) #rt -> RawPtr <Errno> {
	std.debug.assert(
		(flags & MapFlags.PRIVATE) == MapFlags.PRIVATE
		|| (flags & MapFlags.SHARED) == MapFlags.SHARED
		|| (flags & MapFlags.SHARED_VALIDATE) == MapFlags.SHARED_VALIDATE,
		"Flags must have one of PRIVATE, SHARED, or SHARED_VALIDATE"
	);

	unsafe{
		const res: UI64 = native.syscall(
			native.SyscallCode.MMAP,
			std.bitCast<{UI64}>(addr),
			length as UI64,
			prot as UI64,
			flags as UI64,
			fd as CInt as UI64,
			offset as UI64
		);

		const e: Errno = native.calcErrno(res);
		if(e == Errno.SUCCESS){ return std.bitCast<{RawPtr}>(res); }
		error copy e;
	}
}

func munmap = (addr: RawPtr, length: USize) #rt -> Void <Errno> {
	unsafe{
		const res: UI64 = native.syscall(native.SyscallCode.MUNMAP, std.bitCast<{UI64}>(addr), length as UI64);

		const e: Errno = native.calcErrno(res);
		if(e == Errno.SUCCESS){ return; }
		error copy e;	
	}
}


func openat = (dirfd: FileDescriptor, path: [Char:*;'\0'], flags: O, mode: Mode) #rt -> FileDescriptor <Errno> {
	std.debug.assert((flags as CInt & 0b11) != 0b11, "Flags must have one of RDONLY, WRONLY, or RDWR");
	std.debug.assert(
		mode != 0 as Mode || ((flags & O.CREAT) != O.CREAT && (flags & O.TMPFILE) != O.TMPFILE),
		"If flags has O.CREAT or O.TMPFILE, mode must be set"
	);

	unsafe{
		const res: UI64 = native.syscall(
			native.SyscallCode.OPENAT,
			dirfd as UI64,
			std.bitCast<{UI64}>(path.data()),
			flags as UI64,
			mode as UI64
		);

		const e: Errno = native.calcErrno(res);
		if(e == Errno.SUCCESS){ return res as FileDescriptor; }
		error copy e;
	}
}



func write = (fd: FileDescriptor, str: [Char:*]) #rt -> ISize {
	unsafe{
		return native.syscall(
			native.SyscallCode.WRITE, fd as CInt as UI64, std.bitCast<{UI64}>(str.data()), str.size() as UI64
		) as ISize;
	}
}
