@setModuleName("std");


//////////////////////////////////////////////////////////////////////
// atomic

type AtomicOrdering = alias @pthr.AtomicOrdering;
type Atomic         = alias @import("atomic/Atomic.pthr").Atomic;
type AtomicRef      = alias @import("atomic/AtomicRef.pthr").AtomicRef;



//////////////////////////////////////////////////////////////////////
// bit

def bit = @import("bit.pthr");

func asBuffer   = alias bit.asBuffer;
func bitCast    = alias bit.bitCast;
func bitCeil    = alias bit.bitCeil;
func bitFloor   = alias bit.bitFloor;
func bitReverse = alias bit.bitReverse;
func bitWidth   = alias bit.bitWidth;
func byteSwap   = alias bit.byteSwap;
func countLZero = alias bit.countLZero;
func countRZero = alias bit.countRZero;
func countLOne  = alias bit.countLOne;
func countROne  = alias bit.countROne;
func popCount   = alias bit.popCount;



//////////////////////////////////////////////////////////////////////
// build

when(@config.compilerMode == @pthr.CompilerMode.BUILD){
	def build = @import("building.pthr");
}else{
	def build = delete("Current compiler mode is not `build`");
}


//////////////////////////////////////////////////////////////////////
// debug

def debug = @import("debug.pthr");



//////////////////////////////////////////////////////////////////////
// heap

def heap = @import("./heap/heap.pthr");



//////////////////////////////////////////////////////////////////////
// math

def math = @import("math.pthr");



//////////////////////////////////////////////////////////////////////
// mem

def mem = @import("mem/mem.pthr");



//////////////////////////////////////////////////////////////////////
// platform

def platform = @import("platform/platform.pthr");



//////////////////////////////////////////////////////////////////////
// ptrMath

def ptrMath = @import("ptrMath.pthr");

func advancePointer  = alias ptrMath.advancePointer;
func pointerDistance = alias ptrMath.pointerDistance;



//////////////////////////////////////////////////////////////////////
// types

def types = @import("types.pthr");



//////////////////////////////////////////////////////////////////////
// containers

def iterators #priv = @import("containers/iterators.pthr");
type ArrayRefIter    = alias iterators.ArrayRefIter;
type MutArrayRefIter = alias iterators.MutArrayRefIter;

type ManualLifetime  = alias @import("containers/ManualLifetime.pthr").ManualLifetime;
type StaticArrayList = alias @import("containers/StaticArrayList.pthr").StaticArrayList;



//////////////////////////////////////////////////////////////////////
// misc

def range_for #priv = @import("misc/rangeFor.pthr");
func rangeFor        = alias range_for.rangeFor;
func reverseRangeFor = alias range_for.reverseRangeFor;



//////////////////////////////////////////////////////////////////////
// writer

type IWriter             = alias @import("writer/Writer.pthr").IWriter;
type Writer              = alias @import("writer/Writer.pthr").Writer;
type PmWriter            = alias @import("writer/Writer.pthr").PmWriter;

type ComptimeStdoutWriter = alias @import("writer/ComptimeStdoutWriter.pthr").ComptimeStdoutWriter;
when(platform.SUPPORTS_CMD){
	type FileWriter           = alias @import("writer/FileWriter.pthr").FileWriter;
	type DebugStdoutWriter    = alias @import("writer/DebugStdoutWriter.pthr").DebugStdoutWriter;
}

type BufferedWriter       = alias @import("writer/BufferedWriter.pthr").BufferedWriter;
type PmBufferedWriter     = alias @import("writer/BufferedWriter.pthr").PmBufferedWriter;

def fmt = @import("writer/fmt.pthr");



//////////////////////////////////////////////////////////////////////
// builtins

type CallingConvention = alias @pthr.CallingConvention;
type Language          = alias @pthr.Language;
type Architecture      = alias @pthr.Architecture;
type Platform          = alias @pthr.Platform;
type WindowsSubsystem  = alias @pthr.WindowsSubsystem;
type Mode              = alias @pthr.Mode;
type OptMode           = alias @pthr.OptMode;
type CompilerMode      = alias @pthr.CompilerMode;


type IIterable         = alias @pthr.IIterable;
type IIterableRT       = alias @pthr.IIterableRT;
type IIterableCT       = alias @pthr.IIterableCT;
type IIterableRef      = alias @pthr.IIterableRef;
type IIterableRefRT    = alias @pthr.IIterableRefRT;
type IIterableRefCT    = alias @pthr.IIterableRefCT;
type IIterableMutRef   = alias @pthr.IIterableMutRef;
type IIterableMutRefRT = alias @pthr.IIterableMutRefRT;
type IIterableMutRefCT = alias @pthr.IIterableMutRefCT;
type IIterator         = alias @pthr.IIterator;
type IIteratorRT       = alias @pthr.IIteratorRT;
type IIteratorCT       = alias @pthr.IIteratorCT;
type IMutIterator      = alias @pthr.IMutIterator;
type IMutIteratorRT    = alias @pthr.IMutIteratorRT;
type IMutIteratorCT    = alias @pthr.IMutIteratorCT;
