@setModuleName("std.mem");

def std = @import("std");



def iallocator #priv = @import("./IAllocator.pthr");
type IAllocator   = alias iallocator.IAllocator;
type IAllocatorRT = alias iallocator.IAllocatorRT;
type IAllocatorCT = alias iallocator.IAllocatorCT;



def allocator #priv = @import("./allocator.pthr");
type Allocator   = alias allocator.Allocator;
type PmAllocator = alias Allocator<{impl(*mut:IAllocator)}>;

type AllocatorRT   = alias allocator.AllocatorRT;
type PmAllocatorRT = alias AllocatorRT<{impl(*mut:IAllocatorRT)}>;

type AllocatorCT   = alias allocator.AllocatorCT;
type PmAllocatorCT = alias AllocatorCT<{impl(*mut:IAllocatorCT)}>;




def buffers #priv = @import("./buffers.pthr");
func copyBuffer = alias buffers.copyBuffer;
func moveBuffer = alias buffers.moveBuffer;

