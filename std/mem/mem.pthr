@setModuleName("std.mem");

def std = @import("std");



def iallocator = @import("./IAllocator.pthr");
type IAllocator   = alias #pub iallocator.IAllocator;
type IAllocatorRT = alias #pub iallocator.IAllocatorRT;
type IAllocatorCT = alias #pub iallocator.IAllocatorCT;



def allocator = @import("./allocator.pthr");
type Allocator   = alias #pub allocator.Allocator;
type PmAllocator = alias #pub Allocator<{}>;
func createAllocator   = alias #pub allocator.createAllocator;
func createPmAllocator = alias #pub allocator.createPmAllocator;

type AllocatorRT   = alias #pub allocator.AllocatorRT;
type PmAllocatorRT = alias #pub AllocatorRT<{}>;
func createAllocatorRT   = alias #pub allocator.createAllocatorRT;
func createPmAllocatorRT = alias #pub allocator.createPmAllocatorRT;

type AllocatorCT   = alias #pub allocator.AllocatorCT;
type PmAllocatorCT = alias #pub AllocatorCT<{}>;
func createAllocatorCT   = alias #pub allocator.createAllocatorCT;
func createPmAllocatorCT = alias #pub allocator.createPmAllocatorCT;




def buffers = @import("./buffers.pthr");
func copyBuffer = alias #pub buffers.copyBuffer;
func moveBuffer = alias #pub buffers.moveBuffer;

