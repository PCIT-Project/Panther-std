@setModuleName("std.mem");

def std #private = @import("std");



//////////////////////////////////////////////////////////////////////
// Allocator


type Allocator = struct <{TargetAllocatorType: Type}> {
	func new = (allocator_impl: impl*mut(TargetAllocatorType:std.mem.IAllocator)) -> (output: This) {
		output.allocator_impl = copy allocator_impl;
		return...;
	}

	

	func alloc = <{T: Type}> (this mut) -> T*uninit <Void> {
		def NUM_BYTES: USize = std.types.numBytes<{T}>();
		def NUM_BYTES_ALIGNMENT: UI32 = std.types.numAlignBytes<{T}>();

		const new_alloc: [Byte:*] = try this.allocator_impl.alloc(NUM_BYTES, NUM_BYTES_ALIGNMENT) else { error; };

		unsafe{
			return std.bitCast<{T*uninit}>(new_alloc.data());
		}
	}

	func alloc = <{T: Type}> (this, num_elements: USize) -> [std.ManualLifetime<{T}>:*mut] {
		const num_bytes: USize = std.types.numBytes<{T}>() * num_elements;
		def NUM_BYTES_ALIGNMENT: UI32 = std.types.numAlignBytes<{T}>();

		const new_alloc: [Byte:*] = try this.allocator_impl.alloc(num_bytes, NUM_BYTES_ALIGNMENT) else { error; };

		unsafe{
			return new [std.ManualLifetime<{T}>:*mut](
				std.bitCast<{std.ManualLifetime<{T}>*mut}>(new_alloc.data()), copy num_elements
			);
		}
	}

	func dealloc = (this mut, ptr: $T*mut) -> Void {
		when(std.types.isTriviallyDeletable<{T}>() == false){
			unsafe{ delete ptr.*; }
		}

		this.allocator_impl.dealloc(std.asBuffer(ptr), std.types.numAlignBytes<{T}>());
	}

	func dealloc = (this mut, ptr: $T*uninit) #unsafe -> Void = delete(
		"Incorrect method - did you mean to initialize the pointer first, or did you mean to call `.deallocWithoutDelete()` instead?"
	);

	func dealloc = (this mut, buffer: [$T:*mut]) -> Void {
		when(std.types.isTriviallyDeletable<{T}>() == false){
			for(buffer) [_; item: T mut] {
				unsafe{
					delete item;
				}
			}
		}

		unsafe{
			this.allocator_impl.dealloc(
				new [Byte:*](std.bitCast<{Byte*}>(buffer.data()), buffer.size() * std.types.numBytes<{T}>()),
				std.types.numAlignBytes<{T}>()
			);
		}
	}


	func deallocWithoutDelete = (this mut, ptr: $T*) #unsafe -> Void {
		this.allocator_impl.dealloc(std.asBuffer(ptr), std.types.numAlignBytes<{T}>());
	}

	func deallocWithoutDelete = (this mut, ptr: $T*uninit) #unsafe -> Void {
		this.allocator_impl.dealloc(std.asBuffer(std.bitCast<{T*}>(ptr), std.types.numAlignBytes<{T}>()));
	}

	func deallocWithoutDelete = (this mut, buffer: [$T:*mut]) #unsafe -> Void {
		this.allocator_impl.dealloc(
			new [Byte:*](std.bitCast<{Byte*}>(buffer.data()), buffer.size() * std.types.numBytes<{T}>()),
			std.types.numAlignBytes<{T}>()
		);
	}



	func allocResize = (this, buffer: [$Ptr:*], new_size: USize) -> Void <Void> {
		unsafe{
			const byte_buffer = new [Byte:*](std.bitCast<{Byte*}>(buffer.data()), buffer.size());
			try this.allocator_impl.allocResize(byte_buffer, std.types.numAlignBytes<{Ptr}>(), new_size) else {
				error;
			};
		}
	}

	func allocResize = (this, ptr: $Ptr*, new_size: USize) -> Void <Void> {
		this.allocResize(new [Ptr:*](copy ptr, 1), std.types.numAlignBytes<{Ptr}>(), new_size);
	}



	impl std.mem.IAllocator {
		alloc = (this mut, size: USize, alignment: UI32) -> [Byte:*mut] <Void> {
			return try this.allocator_impl.alloc(size, alignment) else { error; };
		},

		allocResize = (this mut, buffer: [Byte:*], alignment: UI32, new_size: USize) -> Void <Void> {
			try this.allocator_impl.allocResize(buffer, alignment, new_size) else { error; };
		},

		dealloc = (this mut, buffer: [Byte:*], alignment: UI32) -> Void {
			this.allocator_impl.dealloc(buffer, alignment);
		},
	}



	//////////////////////////////////////////////////////////////////////
	// private

	var allocator_impl: impl*mut(TargetAllocatorType:std.mem.IAllocator) #private;
}



//////////////////////////////////////////////////////////////////////
// AllocatorRT

type AllocatorRT = struct <{TargetAllocatorRTType: Type}> {
	func new = (allocator_impl: impl*mut(TargetAllocatorRTType:std.mem.IAllocatorRT)) #rt -> (output: This) {
		output.allocator_impl = copy allocator_impl;
		return...;
	}


	

	func alloc = <{T: Type}> (this mut) #rt -> T*uninit {
		def NUM_BYTES: USize = std.types.numBytes<{T}>();
		def NUM_BYTES_ALIGNMENT: UI32 = std.types.numAlignBytes<{T}>();

		const new_alloc: [Byte:*] = try this.allocator_impl.alloc(NUM_BYTES, NUM_BYTES_ALIGNMENT) else { error; };

		unsafe{
			return std.bitCast<{T*uninit}>(new_alloc.data());
		}
	}

	func alloc = <{T: Type}> (this, num_elements: USize) #rt -> [std.ManualLifetime<{T}>:*mut] {
		const num_bytes: USize = std.types.numBytes<{T}>() * num_elements;
		def NUM_BYTES_ALIGNMENT: UI32 = std.types.numAlignBytes<{T}>();

		const new_alloc: [Byte:*] = try this.allocator_impl.alloc(num_bytes, NUM_BYTES_ALIGNMENT) else { error; };

		unsafe{
			return new [std.ManualLifetime<{T}>:*mut](
				std.bitCast<{std.ManualLifetime<{T}>*mut}>(new_alloc.data()), copy num_elements
			);
		}
	}

	func dealloc = (this mut, ptr: $T*mut) #rt -> Void {
		when(std.types.isTriviallyDeletable<{T}>() == false){
			unsafe{ delete ptr.*; }
		}

		this.allocator_impl.dealloc(std.asBuffer(ptr), std.types.numAlignBytes<{T}>());
	}

	func dealloc = (this mut, buffer: [$T:*mut]) #rt -> Void {
		when(std.types.isTriviallyDeletable<{T}>() == false){
			for(buffer) [_; item: T mut] {
				unsafe{
					delete item;
				}
			}
		}

		unsafe{
			this.allocator_impl.dealloc(
				new [Byte:*](std.bitCast<{Byte*}>(buffer.data()), buffer.size() * std.types.numBytes<{T}>()),
				std.types.numAlignBytes<{T}>()
			);
		}
	}


	func deallocWithoutDelete = (this mut, ptr: $T*) #unsafe #rt -> Void {
		this.allocator_impl.dealloc(std.asBuffer(ptr), std.types.numAlignBytes<{T}>());
	}

	func deallocWithoutDelete = (this mut, ptr: $T*uninit) #unsafe #rt -> Void {
		this.allocator_impl.dealloc(std.asBuffer(std.bitCast<{T*}>(ptr)), std.types.numAlignBytes<{T}>());
	}

	func deallocWithoutDelete = (this mut, buffer: [$T:*mut]) #unsafe #rt -> Void {
		this.allocator_impl.dealloc(
			new [Byte:*](std.bitCast<{Byte*}>(buffer.data()), buffer.size() * std.types.numBytes<{T}>()),
			std.types.numAlignBytes<{T}>()
		);
	}


	func allocResize = (this, buffer: [$Ptr:*], new_size: USize) #rt -> Void <Void> {
		unsafe{
			const byte_buffer = new [Byte:*](std.bitCast<{Byte*}>(buffer.data()), buffer.size());
			try this.allocator_impl.allocResize(byte_buffer, std.types.numAlignBytes<{Ptr}>(), new_size) else {
				error;
			};
		}
	}

	func allocResize = (this, ptr: $Ptr*, new_size: USize) #rt -> Void <Void> {
		this.allocResize(new [Ptr:*](copy ptr, 1), std.types.numAlignBytes<{Ptr}>(), new_size);
	}



	impl std.mem.IAllocatorRT {
		alloc = (this mut, size: USize, alignment: UI32) #rt -> [Byte:*mut] <Void> {
			return try this.allocator_impl.alloc(size, alignment) else { error; };
		},

		allocResize = (this mut, buffer: [Byte:*], alignment: UI32, new_size: USize) #rt -> Void <Void> {
			try this.allocator_impl.allocResize(buffer, alignment, new_size) else { error; };
		},

		dealloc = (this mut, buffer: [Byte:*], alignment: UI32) #rt -> Void {
			this.allocator_impl.dealloc(buffer, alignment);
		},
	}



	//////////////////////////////////////////////////////////////////////
	// private

	var allocator_impl: impl*mut(TargetAllocatorRTType:std.mem.IAllocatorRT) #private;
}



//////////////////////////////////////////////////////////////////////
// AllocatorCT

type AllocatorCT = struct <{TargetAllocatorCTType: Type = impl(*mut:std.mem.IAllocatorCT)}> {
	func new = (allocator_impl: impl*mut(TargetAllocatorCTType:std.mem.IAllocatorCT)) -> (output: This) {
		output.allocator_impl = copy allocator_impl;
		return...;
	}


	

	func alloc = <{T: Type}> (this mut) #ct -> T*uninit <Void> {
		def NUM_BYTES: USize = std.types.numBytes<{T}>();
		def NUM_BYTES_ALIGNMENT: UI32 = std.types.numAlignBytes<{T}>();

		const new_alloc: [Byte:*] = try this.allocator_impl.alloc(num_bytes, NUM_BYTES_ALIGNMENT) else { error; };

		unsafe{
			return std.bitCast<{T*uninit}>(this.allocator_impl.alloc(NUM_BYTES, NUM_BYTES_ALIGNMENT).data());
		}
	}

	func alloc = <{T: Type}> (this, num_elements: USize) #ct -> [std.ManualLifetime<{T}>:*mut] {
		const num_bytes: USize = std.types.numBytes<{T}>() * num_elements;
		def NUM_BYTES_ALIGNMENT: UI32 = std.types.numAlignBytes<{T}>();

		const new_alloc: [Byte:*] = try this.allocator_impl.alloc(num_bytes, NUM_BYTES_ALIGNMENT) else { error; };

		unsafe{
			return new [std.ManualLifetime<{T}>:*mut](
				std.bitCast<{std.ManualLifetime<{T}>*mut}>(new_alloc.data()), copy num_elements
			);
		}
	}

	func dealloc = (this mut, ptr: $T*mut) #ct -> Void {
		when(std.types.isTriviallyDeletable<{T}>() == false){
			unsafe{ delete ptr.*; }
		}

		this.allocator_impl.dealloc(std.asBuffer(ptr), std.types.numAlignBytes<{T}>());
	}

	func dealloc = (this mut, buffer: [$T:*mut]) #ct -> Void {
		when(std.types.isTriviallyDeletable<{T}>() == false){
			for(buffer) [_; item: T mut] {
				unsafe{
					delete item;
				}
			}
		}

		unsafe{
			this.allocator_impl.dealloc(
				new [Byte:*](std.bitCast<{Byte*}>(buffer.data()), buffer.size() * std.types.numBytes<{T}>()),
				std.types.numAlignBytes<{T}>()
			);
		}
	}


	func deallocWithoutDelete = (this mut, ptr: $T*) #unsafe #ct -> Void {
		this.allocator_impl.dealloc(std.asBuffer(ptr), std.types.numAlignBytes<{T}>());
	}

	func deallocWithoutDelete = (this mut, ptr: $T*uninit) #unsafe #ct -> Void {
		this.allocator_impl.dealloc(std.asBuffer(std.bitCast<{T*}>(ptr)), std.types.numAlignBytes<{T}>());
	}

	func deallocWithoutDelete = (this mut, buffer: [$T:*mut]) #unsafe #ct -> Void {
		this.allocator_impl.dealloc(
			new [Byte:*](std.bitCast<{Byte*}>(buffer.data()), buffer.size() * std.types.numBytes<{T}>()),
			std.types.numAlignBytes<{T}>()
		);
	}


	func allocResize = (this, buffer: [$Ptr:*], new_size: USize) #ct -> Void <Void> {
		unsafe{
			const byte_buffer = new [Byte:*](std.bitCast<{Byte*}>(buffer.data()), buffer.size());
			try this.allocator_impl.allocResize(byte_buffer, std.types.numAlignBytes<{Ptr}>(), new_size) else {
				error;
			};
		}
	}

	func allocResize = (this, ptr: $Ptr*, new_size: USize) #ct -> Void <Void> {
		this.allocResize(new [Ptr:*](copy ptr, 1), std.types.numAlignBytes<{Ptr}>(), new_size);
	}



	impl std.mem.IAllocatorCT {
		alloc = (this mut, size: USize, alignment: UI32) #ct -> [Byte:*mut] <Void> {
			return try this.allocator_impl.alloc(size, alignment) else { error; };
		},

		allocResize = (this mut, buffer: [Byte:*], alignment: UI32, new_size: USize) #ct -> Void <Void> {
			try this.allocator_impl.allocResize(buffer, alignment, new_size) else { error; };
		},

		dealloc = (this mut, buffer: [Byte:*], alignment: UI32) #ct -> Void {
			this.allocator_impl.dealloc(buffer, alignment);
		},
	}



	//////////////////////////////////////////////////////////////////////
	// private

	var allocator_impl: impl*mut(TargetAllocatorCTType:std.mem.IAllocatorCT) #private;
}