@setModuleName("std.mem");

def std = @import("std");



interface IAllocator = #pub #polymorphic {
	func alloc       = (this mut, size: USize, alignment: UI32)     #rt -> [Byte:*mut];
	func allocResize = (this mut, buffer: [Byte:*], new_size: USize) #rt -> Void <Void>;
	func dealloc     = (this mut, buffer: [Byte:*])                  #rt -> Void;
}



func createAllocator = (target_allocator: $TargetAllocator mut) #pub #rt -> Allocator<{TargetAllocator}> {
	return new Allocator<{TargetAllocator}>(target_allocator);
}

func createPmAllocator = (target_allocator: $$ mut) #pub #rt -> Allocator<{}> {
	return new Allocator<{}>(target_allocator as impl(*mut:IAllocator));
}


type Allocator = struct <{TargetAllocatorType: Type = impl(*mut:IAllocator)}> #pub
	#comptimeAssert(
		@getTypeID<{TargetAllocatorType}>() != @getTypeID<{impl(*:IAllocator)}>(),
		"Mutable access to the allocator interface is required"
	)
{
	when(@getTypeID<{TargetAllocatorType}>() == @getTypeID<{impl(*mut:IAllocator)}>()){
		func new = (allocator_impl: TargetAllocatorType) #rt -> (output: This) {
			output.allocator_impl = copy allocator_impl;
			return...;
		}

		func new = (allocator_impl: $$ mut) #rt -> (output: This) {
			output.allocator_impl = allocator_impl as impl(*mut:IAllocator);
			return...;
		}

	}else{
		func new = (allocator_impl: TargetAllocatorType mut) #rt -> (output: This) {
			output.allocator_impl = &(allocator_impl as impl(TargetAllocatorType:IAllocator));
			return...;
		}

		func new = (allocator_impl: impl(TargetAllocatorType:IAllocator) mut) #rt -> (output: This) {
			output.allocator_impl = &allocator_impl;
			return...;
		}
	}


	

	func alloc = <{T: Type}> (this mut) #rt -> T*uninit {
		const num_bytes: USize = std.types.numBytes<{T}>();
		const num_bytes_alignment: UI32 = std.types.numAlignBytes<{T}>();

		unsafe{
			return std.bitCast<{T*uninit}>(this.allocator_impl.alloc(num_bytes, num_bytes_alignment).data());
		}
	}

	func alloc = <{T: Type}> (this, num_elements: USize) #rt -> [std.ManualLifetime<{T}>:*mut] {
		const num_bytes: USize = std.types.numBytes<{T}>() * num_elements;
		const num_bytes_alignment: UI32 = std.types.numAlignBytes<{T}>();

		unsafe{
			return new [std.ManualLifetime<{T}>:*mut](
				std.bitCast<{std.ManualLifetime*mut}>(this.allocator_impl.alloc(num_bytes, num_bytes_alignment)),
				num_elements
			);
		}
	}

	func dealloc = (this mut, ptr: $T*mut) #rt -> Void {
		when(std.types.isTriviallyDeletable<{T}>() == false){
			unsafe{ delete ptr.*; }
		}

		this.allocator_impl.dealloc(std.asBytes(ptr.*));
	}

	func dealloc = (this mut, buffer: [$T:*mut]) #rt -> Void {
		when(std.types.isTriviallyDeletable<{T}>() == false){
			for(buffer) [_; item: T mut] {
				unsafe{
					delete item;
				}
			}
		}

		this.allocator_impl.dealloc(
			new [Byte:*](std.bitCast<{Byte*}>(buffer.data()), buffer.size() * std.types.numBytes<{T}>())
		);
	}


	func allocResize = (this, buffer: [$$:*], new_size: USize) #rt -> Void <Void> {
		const byte_buffer = new [Byte:*](std.bitCast<{Byte*}>(buffer.data()), buffer.size());
		try this.allocator_impl.allocResize(byte_buffer, new_size) else { error; };
	}

	func allocResize = (this, ptr: $Ptr*, new_size: USize) #rt -> Void <Void> {
		this.allocResize(new [Ptr:*](copy ptr, 1), new_size);
	}



	//////////////////////////////////////////////////////////////////////
	// private

	when(@getTypeID<{TargetAllocatorType}>() == @getTypeID<{impl(*mut:IAllocator)}>()){
		var allocator_impl: impl(*mut:IAllocator) #priv;
	}else{
		var allocator_impl: impl(TargetAllocatorType:IAllocator)*mut #priv;
	}
}

