@setModuleName("std.mem");

def std = @import("std");



//////////////////////////////////////////////////////////////////////
// Allocator

type Allocator = struct <{TargetAllocatorType: Type}> #pub {
	func new = (allocator_impl: impl*mut(TargetAllocatorType:std.mem.IAllocator)) -> (output: This) {
		output.allocator_impl = copy allocator_impl;
		return...;
	}

	

	func alloc = <{T: Type}> (this mut) -> T*uninit {
		const num_bytes: USize = std.types.numBytes<{T}>();
		const num_bytes_alignment: UI32 = std.types.numAlignBytes<{T}>();

		unsafe{
			return std.bitCast<{T*uninit}>(this.allocator_impl.alloc(num_bytes, num_bytes_alignment).data());
		}
	}

	func alloc = <{T: Type}> (this, num_elements: USize) -> [std.ManualLifetime<{T}>:*mut] {
		const num_bytes: USize = std.types.numBytes<{T}>() * num_elements;
		const num_bytes_alignment: UI32 = std.types.numAlignBytes<{T}>();

		const new_alloc: [Byte:*] = this.allocator_impl.alloc(num_bytes, num_bytes_alignment);

		unsafe{
			return new [std.ManualLifetime<{T}>:*mut](
				std.bitCast<{std.ManualLifetime<{T}>*mut}>(new_alloc.data()), copy num_elements
			);
		}
	}

	func dealloc = (this mut, ptr: $T*mut) -> Void {
		when(std.types.isTriviallyDeletable<{T}>() == false){
			unsafe{ delete ptr.*; }
		}

		this.allocator_impl.dealloc(std.asBytes(ptr.*));
	}

	func dealloc = (this mut, buffer: [$T:*mut]) -> Void {
		when(std.types.isTriviallyDeletable<{T}>() == false){
			for(buffer) [_; item: T mut] {
				unsafe{
					delete item;
				}
			}
		}

		unsafe{
			this.allocator_impl.dealloc(
				new [Byte:*](std.bitCast<{Byte*}>(buffer.data()), buffer.size() * std.types.numBytes<{T}>())
			);
		}
	}


	func allocResize = (this, buffer: [$$:*], new_size: USize) -> Void <Void> {
		unsafe{
			const byte_buffer = new [Byte:*](std.bitCast<{Byte*}>(buffer.data()), buffer.size());
			try this.allocator_impl.allocResize(byte_buffer, new_size) else { error; };
		}
	}

	func allocResize = (this, ptr: $Ptr*, new_size: USize) -> Void <Void> {
		this.allocResize(new [Ptr:*](copy ptr, 1), new_size);
	}



	impl std.mem.IAllocator {
		alloc = (this mut, size: USize, alignment: UI32) -> [Byte:*mut] {
			return this.allocator_impl.alloc(size, alignment);
		},

		allocResize = (this mut, buffer: [Byte:*], new_size: USize) -> Void <Void> {
			try this.allocator_impl.allocResize(buffer, new_size) else { error; };
		},

		dealloc = (this mut, buffer: [Byte:*]) -> Void {
			this.allocator_impl.dealloc(buffer);
		},
	}



	//////////////////////////////////////////////////////////////////////
	// private

	var allocator_impl: impl*mut(TargetAllocatorType:std.mem.IAllocator) #priv;
}



//////////////////////////////////////////////////////////////////////
// AllocatorRT

type AllocatorRT = struct <{TargetAllocatorRTType: Type}> #pub {
	func new = (allocator_impl: impl*mut(TargetAllocatorRTType:std.mem.IAllocatorRT)) #rt -> (output: This) {
		output.allocator_impl = copy allocator_impl;
		return...;
	}


	

	func alloc = <{T: Type}> (this mut) #rt -> T*uninit {
		const num_bytes: USize = std.types.numBytes<{T}>();
		const num_bytes_alignment: UI32 = std.types.numAlignBytes<{T}>();

		unsafe{
			return std.bitCast<{T*uninit}>(this.allocator_impl.alloc(num_bytes, num_bytes_alignment).data());
		}
	}

	func alloc = <{T: Type}> (this, num_elements: USize) #rt -> [std.ManualLifetime<{T}>:*mut] {
		const num_bytes: USize = std.types.numBytes<{T}>() * num_elements;
		const num_bytes_alignment: UI32 = std.types.numAlignBytes<{T}>();

		const new_alloc: [Byte:*] = this.allocator_impl.alloc(num_bytes, num_bytes_alignment);

		unsafe{
			return new [std.ManualLifetime<{T}>:*mut](
				std.bitCast<{std.ManualLifetime<{T}>*mut}>(new_alloc.data()), copy num_elements
			);
		}
	}

	func dealloc = (this mut, ptr: $T*mut) #rt -> Void {
		when(std.types.isTriviallyDeletable<{T}>() == false){
			unsafe{ delete ptr.*; }
		}

		this.allocator_impl.dealloc(std.asBytes(ptr.*));
	}

	func dealloc = (this mut, buffer: [$T:*mut]) #rt -> Void {
		when(std.types.isTriviallyDeletable<{T}>() == false){
			for(buffer) [_; item: T mut] {
				unsafe{
					delete item;
				}
			}
		}

		unsafe{
			this.allocator_impl.dealloc(
				new [Byte:*](std.bitCast<{Byte*}>(buffer.data()), buffer.size() * std.types.numBytes<{T}>())
			);
		}
	}


	func allocResize = (this, buffer: [$$:*], new_size: USize) #rt -> Void <Void> {
		unsafe{
			const byte_buffer = new [Byte:*](std.bitCast<{Byte*}>(buffer.data()), buffer.size());
			try this.allocator_impl.allocResize(byte_buffer, new_size) else { error; };
		}
	}

	func allocResize = (this, ptr: $Ptr*, new_size: USize) #rt -> Void <Void> {
		this.allocResize(new [Ptr:*](copy ptr, 1), new_size);
	}



	impl std.mem.IAllocatorRT {
		alloc = (this mut, size: USize, alignment: UI32) #rt -> [Byte:*mut] {
			return this.allocator_impl.alloc(size, alignment);
		},

		allocResize = (this mut, buffer: [Byte:*], new_size: USize) #rt -> Void <Void> {
			try this.allocator_impl.allocResize(buffer, new_size) else { error; };
		},

		dealloc = (this mut, buffer: [Byte:*]) #rt -> Void {
			this.allocator_impl.dealloc(buffer);
		},
	}



	//////////////////////////////////////////////////////////////////////
	// private

	var allocator_impl: impl*mut(TargetAllocatorRTType:std.mem.IAllocatorRT) #priv;
}



//////////////////////////////////////////////////////////////////////
// AllocatorCT

type AllocatorCT = struct <{TargetAllocatorCTType: Type = impl(*mut:std.mem.IAllocatorCT)}> #pub {
	func new = (allocator_impl: impl*mut(TargetAllocatorCTType:std.mem.IAllocatorCT)) -> (output: This) {
		output.allocator_impl = copy allocator_impl;
		return...;
	}


	

	func alloc = <{T: Type}> (this mut) #ct -> T*uninit {
		const num_bytes: USize = std.types.numBytes<{T}>();
		const num_bytes_alignment: UI32 = std.types.numAlignBytes<{T}>();

		unsafe{
			return std.bitCast<{T*uninit}>(this.allocator_impl.alloc(num_bytes, num_bytes_alignment).data());
		}
	}

	func alloc = <{T: Type}> (this, num_elements: USize) #ct -> [std.ManualLifetime<{T}>:*mut] {
		const num_bytes: USize = std.types.numBytes<{T}>() * num_elements;
		const num_bytes_alignment: UI32 = std.types.numAlignBytes<{T}>();

		const new_alloc: [Byte:*] = this.allocator_impl.alloc(num_bytes, num_bytes_alignment);

		unsafe{
			return new [std.ManualLifetime<{T}>:*mut](
				std.bitCast<{std.ManualLifetime<{T}>*mut}>(new_alloc.data()), copy num_elements
			);
		}
	}

	func dealloc = (this mut, ptr: $T*mut) #ct -> Void {
		when(std.types.isTriviallyDeletable<{T}>() == false){
			unsafe{ delete ptr.*; }
		}

		this.allocator_impl.dealloc(std.asBytes(ptr.*));
	}

	func dealloc = (this mut, buffer: [$T:*mut]) #ct -> Void {
		when(std.types.isTriviallyDeletable<{T}>() == false){
			for(buffer) [_; item: T mut] {
				unsafe{
					delete item;
				}
			}
		}

		unsafe{
			this.allocator_impl.dealloc(
				new [Byte:*](std.bitCast<{Byte*}>(buffer.data()), buffer.size() * std.types.numBytes<{T}>())
			);
		}
	}


	func allocResize = (this, buffer: [$$:*], new_size: USize) #ct -> Void <Void> {
		unsafe{
			const byte_buffer = new [Byte:*](std.bitCast<{Byte*}>(buffer.data()), buffer.size());
			try this.allocator_impl.allocResize(byte_buffer, new_size) else { error; };
		}
	}

	func allocResize = (this, ptr: $Ptr*, new_size: USize) #ct -> Void <Void> {
		this.allocResize(new [Ptr:*](copy ptr, 1), new_size);
	}



	impl std.mem.IAllocatorCT {
		alloc = (this mut, size: USize, alignment: UI32) #ct -> [Byte:*mut] {
			return this.allocator_impl.alloc(size, alignment);
		},

		allocResize = (this mut, buffer: [Byte:*], new_size: USize) #ct -> Void <Void> {
			try this.allocator_impl.allocResize(buffer, new_size) else { error; };
		},

		dealloc = (this mut, buffer: [Byte:*]) #ct -> Void {
			this.allocator_impl.dealloc(buffer);
		},
	}



	//////////////////////////////////////////////////////////////////////
	// private

	var allocator_impl: impl*mut(TargetAllocatorCTType:std.mem.IAllocatorCT) #priv;
}