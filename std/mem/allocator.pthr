@setModuleName("std.mem");

def std = @import("std");



//////////////////////////////////////////////////////////////////////
// Allocator

func createAllocator = (target_allocator: $TargetAllocator mut) #pub -> Allocator<{TargetAllocator}> {
	return new Allocator<{TargetAllocator}>(target_allocator);
}

func createPmAllocator = (target_allocator: $$ mut) #pub -> Allocator<{}> {
	return new Allocator<{}>(target_allocator as impl(*mut:std.mem.IAllocator));
}


type Allocator = struct <{TargetAllocatorType: Type = impl(*mut:std.mem.IAllocator)}> #pub
	#comptimeAssert(
		@getTypeID<{TargetAllocatorType}>() != @getTypeID<{impl(*:std.mem.IAllocator)}>(),
		"Mutable access to the allocator interface is required"
	)
{
	when(@getTypeID<{TargetAllocatorType}>() == @getTypeID<{impl(*mut:std.mem.IAllocator)}>()){
		func new = (allocator_impl: TargetAllocatorType) -> (output: This) {
			output.allocator_impl = copy allocator_impl;
			return...;
		}

		func new = (allocator_impl: $$ mut) -> (output: This) {
			output.allocator_impl = allocator_impl as impl(*mut:std.mem.IAllocator);
			return...;
		}

	}else{
		func new = (allocator_impl: TargetAllocatorType mut) -> (output: This) {
			output.allocator_impl = &(allocator_impl as impl(TargetAllocatorType:std.mem.IAllocator));
			return...;
		}

		func new = (allocator_impl: impl(TargetAllocatorType:std.mem.IAllocator) mut) -> (output: This) {
			output.allocator_impl = &allocator_impl;
			return...;
		}
	}


	

	func alloc = <{T: Type}> (this mut) -> T*uninit {
		const num_bytes: USize = std.types.numBytes<{T}>();
		const num_bytes_alignment: UI32 = std.types.numAlignBytes<{T}>();

		unsafe{
			return std.bitCast<{T*uninit}>(this.allocator_impl.alloc(num_bytes, num_bytes_alignment).data());
		}
	}

	func alloc = <{T: Type}> (this, num_elements: USize) -> [std.ManualLifetime<{T}>:*mut] {
		const num_bytes: USize = std.types.numBytes<{T}>() * num_elements;
		const num_bytes_alignment: UI32 = std.types.numAlignBytes<{T}>();

		const new_alloc: [Byte:*] = this.allocator_impl.alloc(num_bytes, num_bytes_alignment);

		unsafe{
			return new [std.ManualLifetime<{T}>:*mut](
				std.bitCast<{std.ManualLifetime<{T}>*mut}>(new_alloc.data()), copy num_elements
			);
		}
	}

	func dealloc = (this mut, ptr: $T*mut) -> Void {
		when(std.types.isTriviallyDeletable<{T}>() == false){
			unsafe{ delete ptr.*; }
		}

		this.allocator_impl.dealloc(std.asBytes(ptr.*));
	}

	func dealloc = (this mut, buffer: [$T:*mut]) -> Void {
		when(std.types.isTriviallyDeletable<{T}>() == false){
			for(buffer) [_; item: T mut] {
				unsafe{
					delete item;
				}
			}
		}

		unsafe{
			this.allocator_impl.dealloc(
				new [Byte:*](std.bitCast<{Byte*}>(buffer.data()), buffer.size() * std.types.numBytes<{T}>())
			);
		}
	}


	func allocResize = (this, buffer: [$$:*], new_size: USize) -> Void <Void> {
		unsafe{
			const byte_buffer = new [Byte:*](std.bitCast<{Byte*}>(buffer.data()), buffer.size());
			try this.allocator_impl.allocResize(byte_buffer, new_size) else { error; };
		}
	}

	func allocResize = (this, ptr: $Ptr*, new_size: USize) -> Void <Void> {
		this.allocResize(new [Ptr:*](copy ptr, 1), new_size);
	}



	impl std.mem.IAllocator {
		alloc = (this mut, size: USize, alignment: UI32) -> [Byte:*mut] {
			return this.allocator_impl.alloc(size, alignment);
		},

		allocResize = (this mut, buffer: [Byte:*], new_size: USize) -> Void <Void> {
			try this.allocator_impl.allocResize(buffer, new_size) else { error; };
		},

		dealloc = (this mut, buffer: [Byte:*]) -> Void {
			this.allocator_impl.dealloc(buffer);
		},
	}



	//////////////////////////////////////////////////////////////////////
	// private

	when(@getTypeID<{TargetAllocatorType}>() == @getTypeID<{impl(*mut:std.mem.IAllocator)}>()){
		var allocator_impl: impl(*mut:std.mem.IAllocator) #priv;
	}else{
		var allocator_impl: impl(TargetAllocatorType:std.mem.IAllocator)*mut #priv;
	}
}



//////////////////////////////////////////////////////////////////////
// AllocatorRT


func createAllocatorRT = (target_allocator: $TargetAllocatorRT mut) #pub #rt -> AllocatorRT<{TargetAllocatorRT}> {
	return new AllocatorRT<{TargetAllocatorRT}>(target_allocator);
}

func createPmAllocatorRT = (target_allocator: $$ mut) #pub #rt -> AllocatorRT<{}> {
	return new AllocatorRT<{}>(target_allocator as impl(*mut:std.mem.IAllocatorRT));
}


type AllocatorRT = struct <{TargetAllocatorRTType: Type = impl(*mut:std.mem.IAllocatorRT)}> #pub
	#comptimeAssert(
		@getTypeID<{TargetAllocatorRTType}>() != @getTypeID<{impl(*:std.mem.IAllocatorRT)}>(),
		"Mutable access to the allocator interface is required"
	)
{
	when(@getTypeID<{TargetAllocatorRTType}>() == @getTypeID<{impl(*mut:std.mem.IAllocatorRT)}>()){
		func new = (allocator_impl: TargetAllocatorRTType) #rt -> (output: This) {
			output.allocator_impl = copy allocator_impl;
			return...;
		}

		func new = (allocator_impl: $$ mut) #rt -> (output: This) {
			output.allocator_impl = allocator_impl as impl(*mut:std.mem.IAllocatorRT);
			return...;
		}

	}else{
		func new = (allocator_impl: TargetAllocatorRTType mut) #rt -> (output: This) {
			output.allocator_impl = &(allocator_impl as impl(TargetAllocatorRTType:std.mem.IAllocatorRT));
			return...;
		}

		func new = (allocator_impl: impl(TargetAllocatorRTType:std.mem.IAllocatorRT) mut) #rt -> (output: This) {
			output.allocator_impl = &allocator_impl;
			return...;
		}
	}


	

	func alloc = <{T: Type}> (this mut) #rt -> T*uninit {
		const num_bytes: USize = std.types.numBytes<{T}>();
		const num_bytes_alignment: UI32 = std.types.numAlignBytes<{T}>();

		unsafe{
			return std.bitCast<{T*uninit}>(this.allocator_impl.alloc(num_bytes, num_bytes_alignment).data());
		}
	}

	func alloc = <{T: Type}> (this, num_elements: USize) #rt -> [std.ManualLifetime<{T}>:*mut] {
		const num_bytes: USize = std.types.numBytes<{T}>() * num_elements;
		const num_bytes_alignment: UI32 = std.types.numAlignBytes<{T}>();

		const new_alloc: [Byte:*] = this.allocator_impl.alloc(num_bytes, num_bytes_alignment);

		unsafe{
			return new [std.ManualLifetime<{T}>:*mut](
				std.bitCast<{std.ManualLifetime<{T}>*mut}>(new_alloc.data()), copy num_elements
			);
		}
	}

	func dealloc = (this mut, ptr: $T*mut) #rt -> Void {
		when(std.types.isTriviallyDeletable<{T}>() == false){
			unsafe{ delete ptr.*; }
		}

		this.allocator_impl.dealloc(std.asBytes(ptr.*));
	}

	func dealloc = (this mut, buffer: [$T:*mut]) #rt -> Void {
		when(std.types.isTriviallyDeletable<{T}>() == false){
			for(buffer) [_; item: T mut] {
				unsafe{
					delete item;
				}
			}
		}

		unsafe{
			this.allocator_impl.dealloc(
				new [Byte:*](std.bitCast<{Byte*}>(buffer.data()), buffer.size() * std.types.numBytes<{T}>())
			);
		}
	}


	func allocResize = (this, buffer: [$$:*], new_size: USize) #rt -> Void <Void> {
		unsafe{
			const byte_buffer = new [Byte:*](std.bitCast<{Byte*}>(buffer.data()), buffer.size());
			try this.allocator_impl.allocResize(byte_buffer, new_size) else { error; };
		}
	}

	func allocResize = (this, ptr: $Ptr*, new_size: USize) #rt -> Void <Void> {
		this.allocResize(new [Ptr:*](copy ptr, 1), new_size);
	}



	impl std.mem.IAllocatorRT {
		alloc = (this mut, size: USize, alignment: UI32) #rt -> [Byte:*mut] {
			return this.allocator_impl.alloc(size, alignment);
		},

		allocResize = (this mut, buffer: [Byte:*], new_size: USize) #rt -> Void <Void> {
			try this.allocator_impl.allocResize(buffer, new_size) else { error; };
		},

		dealloc = (this mut, buffer: [Byte:*]) #rt -> Void {
			this.allocator_impl.dealloc(buffer);
		},
	}



	//////////////////////////////////////////////////////////////////////
	// private

	when(@getTypeID<{TargetAllocatorRTType}>() == @getTypeID<{impl(*mut:std.mem.IAllocatorRT)}>()){
		var allocator_impl: impl(*mut:std.mem.IAllocatorRT) #priv;
	}else{
		var allocator_impl: impl(TargetAllocatorRTType:std.mem.IAllocatorRT)*mut #priv;
	}
}



