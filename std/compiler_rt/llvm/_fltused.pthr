@setModuleName("std.compiler_rt");

def std #private = @import("std");

when(@config.platform == std.Platform.WINDOWS && @config.compilerMode != std.CompilerMode.SCRIPT){
	
	// https://github.com/ziglang/zig/issues/24148
	const _fltused: CInt #export = 0;

}
