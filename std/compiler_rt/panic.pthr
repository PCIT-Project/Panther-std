@setModuleName("std.compiler_rt");

def std = @import("std");



func panic = (message: [Char:*]) #noReturn #builtin("panic") #rtDiff -> Void {
	when(@config.mode == std.Mode.DEBUG){
		when(std.os.SUPPORTS_IO){
			std.debug.println("\e[37m\e[41m{}\e[0m", message);
		}

		@breakpoint();
		@abort();

	}else{
		@abort();
	}
}
