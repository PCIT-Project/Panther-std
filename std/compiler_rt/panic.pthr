@setModuleName("std.compiler_rt");

def std #priv = @import("std");



func panic = (message: [Char:*]) #priv #noReturn #builtin("panic") #rtDiff -> Void {
	when(@config.mode == std.Mode.DEBUG){
		when(std.platform.SUPPORTS_CMD){
			std.debug.print("\e[37m\e[41mPCIT Panther Language - `@panic`: \"");
			std.debug.print(message);
			std.debug.print("\"\e[0m\n");
		}

		@breakpoint();
		@abort();

	}else{
		@abort();
	}
}
